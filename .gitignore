**/.pbi/localSettings.json
**/.pbi/cache.abf
# A rep whose sources are not in data/ (no refresh possible) may un-ignore its model cache:
# !<Name>.SemanticModel/.pbi/cache.abf
design/wireframes/data.json
data/*
!data/.gitkeep
_snapshots/
__pycache__/
*.pyc
# Python wheels copied in for an offline install (tools/doctor.ps1)
tools/wheels/
# pbik bind backups and state (bind live / bind local)
.pbik/
# the model drop folder may hold data until pbik model intake runs (it deletes data files first)
design/reference/model/
# one folder = one project: projects never live inside the master kit (the export check fails if one does)
projects/
# a project's drop folders (made on first run): a copy of the model export, and the wireframe / screenshots / report
Model/
Reference/
# v1.11 app visuals: the toolchain lives outside the repo (pbik tools); never commit installs, builds or packages
node_modules/
*.pbiviz
.tmp/
webpack.statistics*.html
