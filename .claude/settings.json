{
  "permissions": {
    "deny": [
      "Skill(reports:create-pbi-report)",
      "Skill(reports:modifying-theme-json)",
      "Skill(reports:pbir-cli)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_model_folder.py\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__computer-use__.*|mcp__remote-devices__computer.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_gates.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/count_messages.py\""
          }
        ]
      }
    ]
  }
}
