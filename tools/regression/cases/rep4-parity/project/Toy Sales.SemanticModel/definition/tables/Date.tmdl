		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Year = FORMAT ( 'Date'[Date], "yyyy" )
		dataType: string
		lineageTag: 30d24e37-103b-4115-8d5a-c640a75da1be
		summarizeBy: none

	column Quarter = "Q" & QUARTER ( 'Date'[Date] )
