		sortByColumn: 'Location Order'

	column Store = SUBSTITUTE ( stores[Store_Name], "Maven Toys ", "" )
		dataType: string
		lineageTag: 648049db-c6b6-4086-b14e-34a74d182578
		summarizeBy: none

	column City = SUBSTITUTE ( stores[Store_City], "Cuidad", "Ciudad" )
