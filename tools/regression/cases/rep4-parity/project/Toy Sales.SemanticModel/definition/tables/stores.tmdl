		lineageTag: 82230ed8-1951-4d21-a419-588e47acf970
		summarizeBy: none

	partition stores = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\pbip-data\Maven Toys\stores.csv"),[Delimiter=",", Columns=5, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Store_ID", Int64.Type}, {"Store_Name", type text}, {"Store_City", type text}, {"Store_Location", type text}, {"Store_Open_Date", type date}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

