model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

extendedProperty SQLBI_BRAVO_ManageDatesConfiguration =
		{
		  "templateUri": "file:///C:/pbip-data/Bravo/ManageDates/Templates/Config-01.template.json",
		  "isCurrent": false,
		  "isCustom": false,
		  "name": "Config-01",
		  "description": "Standard gregorian calendar",
		  "autoScan": 127,
		  "onlyTablesColumns": [],
		  "exceptTablesColumns": [],
		  "isoCountry": "US",
		  "autoNaming": 1,
		  "targetMeasures": [],
		  "defaults": {
		    "firstDayOfWeek": 0
		  },
		  "dateAvailable": true,
		  "dateEnabled": true,
		  "dateTableName": "Date",
		  "dateTableValidation": 1,
		  "dateReferenceTableName": "DateAutoTemplate",
		  "dateReferenceTableValidation": 1,
		  "holidaysAvailable": true,
		  "holidaysEnabled": false,
		  "holidaysTableName": "Holidays",
		  "holidaysTableValidation": 0,
		  "holidaysDefinitionTableName": "HolidaysDefinition",
		  "holidaysDefinitionTableValidation": 0,
		  "timeIntelligenceAvailable": true,
		  "timeIntelligenceEnabled": false
		}

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataTable","Metric Selection"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode","MCP-PBIModeling"]

ref table DataTable
ref table _Measures
ref table DateAutoTemplate
ref table Date
ref table 'Metric Selection'
ref table 'KPI type'
ref table 'Job Satisfaction'
ref table Performance
ref table 'Work-Life Balance'
ref table 'Age Group'

ref cultureInfo en-US

