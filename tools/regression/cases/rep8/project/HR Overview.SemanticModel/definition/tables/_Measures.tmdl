table _Measures
	lineageTag: ce14314c-7ff9-4c66-8002-07e2b8533c9b

	measure _Blank = 0
		formatString: 0
		lineageTag: 4c28d31f-d60d-49ae-8bc7-202c736683e7

	measure 1_Headcount =
			
			CALCULATE(
			COUNTROWS('DataTable'),
			'DataTable'[HireDate] <= MAX('Date'[Date]),
			ISBLANK('DataTable'[TerminationDate]) ||
			'DataTable'[TerminationDate] > MAX('Date'[Date])
			)
		formatString: 0
		lineageTag: f8a8c8a3-7372-450c-ab9d-8c4af8537b05

	measure 3_TotalSalary = ```
			CALCULATE(
			        SUM('DataTable'[Salary]),
			        ISBLANK('DataTable'[TerminationDate]) || 
			        'DataTable'[TerminationDate] > MAX('Date'[Date])
			    )
			
			    
			```
		lineageTag: f5d10ac2-4e12-47a5-839a-5487f6ea7d51

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 2_Hires = ```
			CALCULATE(
			        COUNTROWS('DataTable'),
			        'DataTable'[HireDate] >= MIN('Date'[Date]),
			        'DataTable'[HireDate] <= MAX('Date'[Date])
			    )
			
			    
			```
		formatString: 0
		lineageTag: 62231096-1ba1-4714-835a-6638652dee96

	measure 4_Terminations = ```
			CALCULATE(
			        COUNTROWS('DataTable'),
			        NOT ISBLANK('DataTable'[TerminationDate]),
			        'DataTable'[TerminationDate] >= MIN('Date'[Date]),
			        'DataTable'[TerminationDate] <= MAX('Date'[Date])
			    )
			
			    
			```
		formatString: 0
		lineageTag: 69e1f685-9fd9-4863-85ce-fb3fdc148e98

	measure 5_HireRate = ```
			DIVIDE(
			        '_Measures'[2_Hires], 
			        '_Measures'[1_Headcount],
			        0
			    )
			
			    
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 26a2b413-21c0-488b-a86a-eb9a107f9521

	measure 6_TerminationRate = ```
			DIVIDE(
			        '_Measures'[4_Terminations], 
			        '_Measures'[1_Headcount],
			        0
			    )
			
			    
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fdbac5a1-7a4c-4de0-a124-a81fb462b042

	measure '1_Headcount LY' = ```
			
			 CALCULATE([1_Headcount],SAMEPERIODLASTYEAR('Date'[Date]))
			
			    
			```
		formatString: 0
		lineageTag: 1fddac35-7b11-46cb-8e65-4e71b5f51d2a

	measure '3_TotalSalary LY' = ```
			
			CALCULATE(
			        [3_TotalSalary],
			        SAMEPERIODLASTYEAR('Date'[Date])
			    )
			
			    
			```
		lineageTag: e0e80b4a-cad9-4e1f-bf3f-01976a9c602e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2_Hires LY' = ```
			
			CALCULATE(
			        [2_Hires],
			        SAMEPERIODLASTYEAR('Date'[Date])
			    )
			
			    
			```
		formatString: 0
		lineageTag: c35443db-8917-4e3d-8f11-67e31c83e599

	measure '4_Terminations LY' = ```
			
			CALCULATE(
			        [4_Terminations],
			        SAMEPERIODLASTYEAR('Date'[Date]) 
			    )
			
			    
			```
		formatString: 0
		lineageTag: 77c34332-4a1e-4915-a12a-22b855b7a237

	measure '5_HireRate LY' = ```
			DIVIDE(
			        '_Measures'[2_Hires LY], 
			        '_Measures'[1_Headcount LY],
			        0
			    )
			
			    
			```
		lineageTag: 228d16b1-cee7-48bb-be7c-4269ca4be3f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '6_TerminationRate LY' = ```
			DIVIDE(
			        '_Measures'[4_Terminations LY], 
			        '_Measures'[1_Headcount LY],
			        0
			    )
			
			```
		lineageTag: d468a03f-9158-4a14-af23-802ae18a55ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '1_Headcount BG Color' = ```
			
			    VAR _Delta = '_Measures'[1_Headcount] - '_Measures'[1_Headcount LY]
			    RETURN
			        SWITCH(
			            TRUE(),
			            _Delta > 0, "#E7F3F5",  
			            _Delta = 0, "FFFFFF00",  
			            _Delta < 0, "#F6EDED"   
			        )
			 
			
			```
		lineageTag: a016b997-bf56-4208-8368-9403a617b117

	measure '1_Headcount Font Color' = ```
			
			    VAR _Delta = '_Measures'[1_Headcount] - '_Measures'[1_Headcount LY]
			    RETURN
			        SWITCH(
			            TRUE(),
			            _Delta > 0, "#038D96",  
			            _Delta = 0, "FFFFFF00",  
			            _Delta < 0, "#A84545"   
			        )
			
			
			```
		lineageTag: a74bfaab-329e-4a5f-8be5-d140e60e3d7b

	measure '1_Headcount Reference' = ```
			
			    VAR _Current = '_Measures'[1_Headcount]
			    VAR _LY = '_Measures'[1_Headcount LY]
			    VAR _Growth = DIVIDE(_Current - _LY, _LY)
			    VAR NumOfDigits = IFERROR(LEN(CONVERT(INT(_Current), STRING)), 0)
			    VAR Suffix = ".0" & SWITCH(TRUE(), NumOfDigits >= 13, "T", NumOfDigits >= 10, "B", NumOfDigits >= 7, "M", NumOfDigits >= 4, "K")
			    VAR Commas = REPT(",", SWITCH(TRUE(), NumOfDigits >= 13, "4", NumOfDigits >= 10, "3", NumOfDigits >= 7, "2", NumOfDigits >= 4, "1"))
			    VAR _Format = "#,##0" & Commas & Suffix & ";-#,##0" & Commas & Suffix 
			    RETURN
			        IF(_Growth <> 0, FORMAT(_Current - _LY, _Format) & FORMAT(_Growth, " | 0.0% ▲; | 0.0% ▼; ") & " YoY", BLANK())
			
			
			```
		lineageTag: bbf13d1b-830d-4b8d-900f-31aa024142fa

