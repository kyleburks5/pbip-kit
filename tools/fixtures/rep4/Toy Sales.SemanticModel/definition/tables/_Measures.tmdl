	measure 'Headline Sales' =
			VAR _k = [Metric Name]
			VAR _cur = [Selected Metric]
			VAR _py = [Selected Metric PY]
			VAR _cats =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( products[Product_Category] ), "@v", [Selected Metric] ),
			        NOT ISBLANK ( [@v] ) && [@v] <> 0
			    )
			VAR _top = TOPN ( 1, _cats, [@v], DESC )
			
			VAR _a = ABS ( _cur )
			VAR _t =
			    SWITCH (
			        TRUE (),
			        _a >= 1e8, FORMAT ( _a / 1e6, "0" ) & "M",
			        _a >= 1e7, FORMAT ( _a / 1e6, "0.0" ) & "M",
			        _a >= 1e6, FORMAT ( _a / 1e6, "0.00" ) & "M",
			        _a >= 1e5, FORMAT ( _a / 1e3, "0" ) & "K",
			        _a >= 1e4, FORMAT ( _a / 1e3, "0.0" ) & "K",
			        _a >= 1e3, FORMAT ( _a / 1e3, "0.00" ) & "K",
			        FORMAT ( _a, "0" )
			    )
			VAR _c = IF ( _cur < 0, "−", "" ) & IF ( SELECTEDVALUE ( Metric[Metric Order], 0 ) <> 2, "$", "" ) & _t
			VAR _vs =
			    IF (
			        NOT ISBLANK ( _py ) && _py <> 0,
			        " · " & FORMAT ( DIVIDE ( _cur - _py, ABS ( _py ) ), "+0.0%;−0.0%;0.0%" ) & " on the same months of " & ( VALUE ( MAX ( 'Date'[Year] ) ) - 1 ),
			        " · first year in the data"
			    )
			VAR _lead =
			    IF (
			        COUNTROWS ( _cats ) > 1 && _cur > 0,
			        " · " & MAXX ( _top, products[Product_Category] ) & " lead with "
			            & FORMAT ( DIVIDE ( MAXX ( _top, [@v] ), _cur ), "0%" )
			    )
			RETURN
			    IF ( ISBLANK ( [Units Sold] ), "No data for this selection", _k & " " & _c & " in " & [Period Label] & _vs & _lead )
		displayFolder: Report
		lineageTag: e63aa69f-2249-4ce9-b7e6-b071edb2cd80

	measure 'Trend Title' =
			[Metric Name] & " by month, " & MAX ( 'Date'[Year] )
			    & IF ( NOT ISBLANK ( [Selected Metric PY] ), " vs " & ( VALUE ( MAX ( 'Date'[Year] ) ) - 1 ) )
		displayFolder: Report
		lineageTag: 0f871d43-bf2f-47d8-a71b-b1ed56ae76b6

	measure 'Trend Subtitle' =
			VAR _m =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( 'Date'[Month] ), "@v", [Selected Metric], "@n", CALCULATE ( MAX ( 'Date'[Month No] ) ) ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _best = TOPN ( 1, _m, [@v], DESC, [@n], ASC )
			VAR _bv = MAXX ( _best, [@v] )
			VAR _cur = [Selected Metric]
			VAR _py = [Selected Metric PY]
			
			VAR _a = ABS ( _bv )
			VAR _t =
			    SWITCH (
			        TRUE (),
			        _a >= 1e8, FORMAT ( _a / 1e6, "0" ) & "M",
			        _a >= 1e7, FORMAT ( _a / 1e6, "0.0" ) & "M",
			        _a >= 1e6, FORMAT ( _a / 1e6, "0.00" ) & "M",
			        _a >= 1e5, FORMAT ( _a / 1e3, "0" ) & "K",
			        _a >= 1e4, FORMAT ( _a / 1e3, "0.0" ) & "K",
			        _a >= 1e3, FORMAT ( _a / 1e3, "0.00" ) & "K",
			        FORMAT ( _a, "0" )
			    )
			VAR _c = IF ( _bv < 0, "−", "" ) & IF ( SELECTEDVALUE ( Metric[Metric Order], 0 ) <> 2, "$", "" ) & _t
			RETURN
			    IF (
			        ISBLANK ( [Units Sold] ), "No data for this selection",
			        "Best month " & MAXX ( _best, 'Date'[Month] ) & ", " & _c
			            & IF (
			                NOT ISBLANK ( _py ) && _py <> 0,
			                " · " & [Period Label] & " " & FORMAT ( DIVIDE ( _cur - _py, ABS ( _py ) ), "+0.0%;−0.0%;0.0%" )
			                    & " on the same months of " & ( VALUE ( MAX ( 'Date'[Year] ) ) - 1 ),
			                " · first year in the data"
			            )
			    )
		displayFolder: Report
		lineageTag: a2d2b631-071b-44c7-8cdd-a90b058f8acf

	measure 'Category Title' = [Metric Name] & " by category"
		displayFolder: Report
		lineageTag: e38a4f45-ea63-4bdb-9d2f-df299ac91f1a

	measure 'Category Subtitle' =
			VAR _cats = FILTER ( ADDCOLUMNS ( VALUES ( products[Product_Category] ), "@v", [Selected Metric] ), NOT ISBLANK ( [@v] ) )
			VAR _top = TOPN ( 1, _cats, [@v], DESC )
			RETURN
			    IF (
			        COUNTROWS ( _cats ) = 0, "No data for this selection",
			        IF (
			            COUNTROWS ( _cats ) > 1,
			            MAXX ( _top, products[Product_Category] ) & " lead with "
			                & FORMAT ( DIVIDE ( MAXX ( _top, [@v] ), [Selected Metric] ), "0%" ) & " · "
			        ) & "click a bar to filter the page"
			    )
		displayFolder: Report
		lineageTag: 7659ef7b-fed8-4f21-89cd-a77fb8cc05b1

	measure 'Location Title' = [Metric Name] & " by location type"
		displayFolder: Report
		lineageTag: 9a8bd410-aa3a-4ec8-bce7-5d3eb86db644

	measure 'Location Subtitle' =
			VAR _l = FILTER ( ADDCOLUMNS ( VALUES ( stores[Location Type] ), "@p", [Selected Metric per Store] ), NOT ISBLANK ( [@p] ) )
			VAR _top = TOPN ( 1, _l, [@p], DESC )
			VAR _v = MAXX ( _top, [@p] )
			
			VAR _a = ABS ( _v )
			VAR _t =
			    SWITCH (
			        TRUE (),
			        _a >= 1e8, FORMAT ( _a / 1e6, "0" ) & "M",
			        _a >= 1e7, FORMAT ( _a / 1e6, "0.0" ) & "M",
			        _a >= 1e6, FORMAT ( _a / 1e6, "0.00" ) & "M",
			        _a >= 1e5, FORMAT ( _a / 1e3, "0" ) & "K",
			        _a >= 1e4, FORMAT ( _a / 1e3, "0.0" ) & "K",
			        _a >= 1e3, FORMAT ( _a / 1e3, "0.00" ) & "K",
			        FORMAT ( _a, "0" )
			    )
			VAR _c = IF ( _v < 0, "−", "" ) & IF ( SELECTEDVALUE ( Metric[Metric Order], 0 ) <> 2, "$", "" ) & _t
			RETURN
			    IF ( COUNTROWS ( _l ) = 0, "No data for this selection",
			        "Highest per store: " & MAXX ( _top, stores[Location Type] ) & ", " & _c & " a store" )
		displayFolder: Report
		lineageTag: 3e08bb80-813b-4f09-9ca4-77ad1c5b0ea3

	measure 'Store Rank Top' =
			IF (
			    ISINSCOPE ( stores[Store] ) && NOT ISBLANK ( [Selected Metric] ),
			    RANKX (
			        FILTER ( ALLSELECTED ( stores[Store], stores[City] ), NOT ISBLANK ( [Selected Metric] ) ),
			        [Selected Metric], , DESC, Skip
			    )
			)
		formatString: 0
		isHidden
		displayFolder: Report
		lineageTag: 9307a77c-d222-4a70-a0a2-a581a96ee01e

	measure 'Top Store Value' =
			-- A blank rank (store with no value in the selection) counts as less than 5 in DAX, so guard it with ISBLANK.
			VAR _r = [Store Rank Top]
			RETURN IF ( NOT ISBLANK ( _r ) && _r <= 5, [Selected Metric] )
		displayFolder: Report
		lineageTag: 48ab2cf7-25ba-4b26-a59c-7c1d9a5eab16

		formatStringDefinition = IF ( SELECTEDVALUE ( Metric[Metric Order], 0 ) = 2, "#,0", "\$#,0" )

	measure 'Top Store vs PY %' =
			VAR _r = [Store Rank Top]
