	measure 'vs PY colour' =
			VAR _d = [Selected Metric vs PY %]
			RETURN SWITCH ( TRUE (), ISBLANK ( _d ), "#5B6766", _d >= 0, "#256B4D", "#B42318" )
		isHidden
		displayFolder: Report
		lineageTag: ac129cfe-c5f6-43b9-8185-364b3b1f07ec

	measure 'Top Stores Subtitle' =
			VAR _n = COUNTROWS ( FILTER ( VALUES ( stores[Store] ), NOT ISBLANK ( [Selected Metric] ) ) )
			RETURN
			    IF ( _n = 0, "No data for this selection", "By " & LOWER ( [Metric Name] ) & " of " & _n & " stores in the selection" )
		displayFolder: Report
		lineageTag: 895ac03c-0c3c-4a20-8629-06a0211b2c31

	measure 'Bottom Stores Subtitle' = IF ( ISBLANK ( [Units Sold] ), "No data for this selection", "Lowest " & LOWER ( [Metric Name] ) & " first" )
		displayFolder: Report
		lineageTag: e57983e3-5021-4a93-8239-e76c6fe67842

	measure 'Stocked Pairs' = COUNTROWS ( inventory )
		formatString: #,0
		displayFolder: Report
		lineageTag: eb97d079-bbb0-46b0-83a8-b4217c18f681

	measure 'Low Pairs' = CALCULATE ( [Stocked Pairs], KEEPFILTERS ( inventory[Stock Status] = "Low" ) )
		formatString: #,0
		displayFolder: Report
		lineageTag: 073459ba-4d46-4a07-afce-baf873896def

	measure 'OK Pairs' = CALCULATE ( [Stocked Pairs], KEEPFILTERS ( inventory[Stock Status] = "OK" ) )
		formatString: #,0
		displayFolder: Report
		lineageTag: f917bfd0-e75e-459d-afdc-d419798c7730

	measure 'Overstock Pairs' = CALCULATE ( [Stocked Pairs], KEEPFILTERS ( inventory[Stock Status] = "Overstock" ) )
		formatString: #,0
		displayFolder: Report
		lineageTag: 9c64fe79-7e3e-4566-8c4b-11a0224f5237

	measure 'Headline Inventory' =
			VAR _v = [Inventory Value]
			VAR _doc = [Days of Cover]
			
			VAR _a = ABS ( _v )
			VAR _t =
			    SWITCH (
			        TRUE (),
			        _a >= 1e8, FORMAT ( _a / 1e6, "0" ) & "M",
			        _a >= 1e7, FORMAT ( _a / 1e6, "0.0" ) & "M",
			        _a >= 1e6, FORMAT ( _a / 1e6, "0.00" ) & "M",
			        _a >= 1e5, FORMAT ( _a / 1e3, "0" ) & "K",
			        _a >= 1e4, FORMAT ( _a / 1e3, "0.0" ) & "K",
			        _a >= 1e3, FORMAT ( _a / 1e3, "0.00" ) & "K",
			        FORMAT ( _a, "0" )
			    )
			VAR _c = IF ( _v < 0, "−", "" ) & IF ( TRUE (), "$", "" ) & _t
			RETURN
			    IF (
			        ISBLANK ( [Stocked Pairs] ), "No data for this selection",
			        _c & " of stock at cost covers " & IF ( ISBLANK ( _doc ), "–", FORMAT ( _doc, "0.0" ) ) & " days of sales · "
			            & FORMAT ( [Out-of-Stock Count], "#,0" ) & " pairs out of stock, "
			            & FORMAT ( [Low Pairs] + 0, "#,0" ) & " running low"
			    )
		displayFolder: Report
		lineageTag: 53005128-e75c-41b3-a860-d5ec3ce485fd

	measure 'Inventory Value caption' = "at cost · " & FORMAT ( [Stocked Pairs], "#,0" ) & " stocked product–store pairs"
		displayFolder: Report
		lineageTag: 3015b0f7-7947-45c0-82da-296d7e427230

	measure 'Units On Hand caption' =
			VAR _s = DISTINCTCOUNT ( inventory[Store_ID] )
			VAR _p = DISTINCTCOUNT ( inventory[Product_ID] )
			RETURN
			    "across " & _s & IF ( _s = 1, " store", " stores" ) & " and " & _p & IF ( _p = 1, " product", " products" )
		displayFolder: Report
		lineageTag: 38599101-e947-44e4-99f4-4d27707e08a7

	measure 'Days of Cover caption' = "selling " & FORMAT ( [Avg Daily Units 90d], "#,0" ) & " units a day (last 90 days)"
		displayFolder: Report
		lineageTag: c02c38fe-77f0-4ae5-b642-f87f4d157935

	measure 'Out-of-Stock caption' = "of " & FORMAT ( [Stocked Pairs], "#,0" ) & " stocked pairs · " & FORMAT ( [Low Pairs] + 0, "#,0" ) & " Low in total"
		displayFolder: Report
		lineageTag: d9820980-04b8-42d9-805d-db5d6be8f2d4

	measure 'Inventory Category Subtitle' =
			VAR _cats = FILTER ( ADDCOLUMNS ( VALUES ( products[Product_Category] ), "@v", [Inventory Value] ), NOT ISBLANK ( [@v] ) )
			VAR _top = TOPN ( 1, _cats, [@v], DESC )
			RETURN
			    IF (
			        COUNTROWS ( _cats ) = 0, "No data for this selection",
			        IF (
			            COUNTROWS ( _cats ) > 1,
			            MAXX ( _top, products[Product_Category] ) & ": "
			                & FORMAT ( DIVIDE ( MAXX ( _top, [@v] ), [Inventory Value] ), "0%" ) & " of the value at cost · "
			        ) & "click a bar to filter the page"
			    )
		displayFolder: Report
		lineageTag: 136ca7d2-8897-4234-af5e-f3cbd6ea9a33

	measure 'Risk Score' =
			VAR _oh = [Units On Hand]
			VAR _d = [Avg Daily Units 90d]
			VAR _c = [Days of Cover]
			VAR _key =
			    SWITCH (
			        [Stock Status],
			        "Low", 1e7 + IF ( ISBLANK ( _c ), 0, _c * 1000 - MIN ( COALESCE ( _d, 0 ), 999 ) ),
			        "Overstock", 2e7 + IF ( ISBLANK ( _c ), 0, 100000 - _c ),
			        3e7 + _c
			    )
			RETURN
			    -- Urgency order: Low (zero and lowest cover first, faster sellers first), Overstock (idle stock, then highest
			    -- cover), OK (lowest cover). Tie-break on the IDs so ranks are unique.
			    IF (
			        NOT ISBLANK ( _oh ),
			        _key + ( MAX ( stores[Store_ID] ) * 100 + MAX ( products[Product_ID] ) ) / 1e6
			    )
		isHidden
		displayFolder: Report
		lineageTag: cc46afc5-513b-4779-b2e5-11329f4e7c68

	measure 'Risk Rank' =
			IF (
			    NOT ISBLANK ( [Risk Score] ),
			    RANKX (
			        FILTER ( CROSSJOIN ( ALLSELECTED ( products[Product_Name] ), ALLSELECTED ( stores[Store] ) ), NOT ISBLANK ( [Risk Score] ) ),
			        [Risk Score], , ASC, Dense
			    )
			)
		formatString: 0
		isHidden
		displayFolder: Report
		lineageTag: 7d81d668-3f26-423e-bddc-a7de8803b976

	/// The '#' column: the rank, shown only for the 15 most urgent pairs (rows beyond 15 are blank and drop out).
	measure 'Risk No' =
			-- A blank rank (pair not stocked) counts as less than 15 in DAX, so guard it with ISBLANK.
			VAR _r = [Risk Rank]
			RETURN IF ( NOT ISBLANK ( _r ) && _r <= 15, _r )
		formatString: 0
		displayFolder: Report
		lineageTag: aae51635-0950-46b0-b233-b2b3f7621215

	measure 'Risk On Hand' =
			VAR _r = [Risk Rank]
			RETURN IF ( NOT ISBLANK ( _r ) && _r <= 15, [Units On Hand] )
		formatString: #,0
		displayFolder: Report
		lineageTag: 4efa5149-a549-492e-abb6-a248ddc05d57

	measure 'Risk Units per Day' =
			VAR _r = [Risk Rank]
			RETURN IF ( NOT ISBLANK ( _r ) && _r <= 15, COALESCE ( [Avg Daily Units 90d], 0 ) )
		formatString: 0.00
		displayFolder: Report
		lineageTag: 94f7b388-c87d-40bf-b5ee-bee7e2aa5fc9

	measure 'Risk Days of Cover' =
			VAR _r = [Risk Rank]
			RETURN IF ( NOT ISBLANK ( _r ) && _r <= 15, [Days of Cover] )
		formatString: #,0.0
		displayFolder: Report
		lineageTag: 25cb9d28-28fb-4190-97be-3f5f3490ec2b

	measure 'Risk Status' =
			VAR _r = [Risk Rank]
			RETURN IF ( NOT ISBLANK ( _r ) && _r <= 15, [Stock Status] )
		displayFolder: Report
		lineageTag: 32ad10bd-f620-42d4-b979-e3b28b0ec018

	measure 'Status Background' =
			SWITCH (
			    [Risk Status],
			    "Low", "#FCE4DE",
			    "OK", "#E4F3F0",
			    "Overstock", "#FBF0D6"
			)
		isHidden
		displayFolder: Report
		lineageTag: a980cd4e-4b9b-473d-bd9d-0f8db91bccf4

	measure 'Status Font' =
			SWITCH (
			    [Risk Status],
			    "Low", "#B23A27",
			    "OK", "#0F4D4A",
			    "Overstock", "#8A5B00"
			)
		isHidden
		displayFolder: Report
		lineageTag: d914d576-3645-4aae-9065-759ebe81e7f3

	measure 'Risk Table Subtitle' =
			VAR _l = [Low Pairs] + 0
			VAR _o = [OK Pairs] + 0
			VAR _v = [Overstock Pairs] + 0
			VAR _parts =
			    CONCATENATEX (
			        FILTER ( { ( "Low", 1, _l ), ( "OK", 2, _o ), ( "Overstock", 3, _v ) }, [Value3] > 0 ),
			        FORMAT ( [Value3], "#,0" ) & " " & [Value1], " · ", [Value2], ASC
			    )
			VAR _rule =
			    SWITCH (
			        TRUE (),
			        _l > 0, "out of stock and lowest cover first",
			        _v > 0, "no sales in 90 days first, then highest cover",
			        "lowest cover first"
			    )
			RETURN
			    IF ( _l + _o + _v = 0, "No data for this selection", _parts & " · " & _rule )
		displayFolder: Report
		lineageTag: 783b6379-bd15-4e98-adb7-8057b421023d

