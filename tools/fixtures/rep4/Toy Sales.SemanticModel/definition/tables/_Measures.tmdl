/// Home table for the report measures.
table _Measures
	lineageTag: ba92e4a0-4dff-4061-9d0b-aee2c376458c

	/// Sum of units sold.
	measure 'Units Sold' = SUM ( sales[Units] )
		formatString: #,0
		displayFolder: Model
		lineageTag: 7ecfb5d7-c5bd-4f3a-8365-b06f58cea355

	/// Units multiplied by retail price, row by row.
	measure Revenue = SUMX ( sales, sales[Units] * RELATED ( products[Product_Price] ) )
		formatString: \$#,0
		displayFolder: Model
		lineageTag: d7639e00-2211-4a6e-bc1a-975a65542ab7

	/// Units multiplied by product cost, row by row.
	measure Cost = SUMX ( sales, sales[Units] * RELATED ( products[Product_Cost] ) )
		formatString: \$#,0
		displayFolder: Model
		lineageTag: 4a5b297b-4099-43b1-ae89-2ad9739d3960

	/// Revenue minus cost.
	measure Profit = [Revenue] - [Cost]
		formatString: \$#,0
		displayFolder: Model
		lineageTag: 7e0d5189-aa32-41f2-b388-712e082c308c

	/// Profit divided by revenue.
	measure 'Margin %' = DIVIDE ( [Profit], [Revenue] )
		formatString: 0.0%
		displayFolder: Model
		lineageTag: 25f7f73f-d137-4715-a58f-9198bf5844b9

	/// Revenue for the same dates one year earlier.
	measure 'Revenue PY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0
		displayFolder: Model
		lineageTag: bf84be3c-d2b8-4775-b55a-5790cadb304b

	/// Profit for the same dates one year earlier.
	measure 'Profit PY' = CALCULATE ( [Profit], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0
		displayFolder: Model
		lineageTag: 4108edeb-b60f-4157-9f42-fcd7e997e5fc

	/// Units sold for the same dates one year earlier.
	measure 'Units Sold PY' = CALCULATE ( [Units Sold], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: #,0
		displayFolder: Model
		lineageTag: 04251acd-6ff1-4648-9dd3-e4987c9bff2c

	/// Margin % for the same dates one year earlier.
	measure 'Margin % PY' = CALCULATE ( [Margin %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.0%
		displayFolder: Model
		lineageTag: 6ef06711-352f-4311-bd86-9df29582be3c

	/// Change in revenue against the same period last year.
	measure 'Revenue vs PY %' = DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Model
		lineageTag: aa77d513-3046-4dfb-8494-2f2c261e84e9

	/// Change in profit against the same period last year.
	measure 'Profit vs PY %' = DIVIDE ( [Profit] - [Profit PY], [Profit PY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Model
		lineageTag: cc1ead9b-4467-449e-a4eb-d8164ade06f4

	/// Change in units sold against the same period last year.
	measure 'Units Sold vs PY %' = DIVIDE ( [Units Sold] - [Units Sold PY], [Units Sold PY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Model
		lineageTag: 4d832017-030c-4487-b886-27ff180f9846

	/// Change in margin against the same period last year, in percentage points.
	measure 'Margin % vs PY' = IF ( NOT ISBLANK ( [Margin % PY] ), ( [Margin %] - [Margin % PY] ) * 100 )
		formatString: +0.0" pts";-0.0" pts";0.0" pts"
		displayFolder: Model
		lineageTag: 41ba1848-ff59-4898-b8e6-531031e41536

	/// Stock on hand multiplied by product cost (snapshot taken as 1 Oct 2023).
	measure 'Inventory Value' = SUMX ( inventory, inventory[Stock_On_Hand] * RELATED ( products[Product_Cost] ) )
		formatString: \$#,0
		displayFolder: Model
		lineageTag: 4ddc37ec-5bb4-4611-a589-0f524b4298d4

	/// Stock on hand in units.
	measure 'Units On Hand' = SUM ( inventory[Stock_On_Hand] )
		formatString: #,0
		displayFolder: Model
		lineageTag: 167a6a3f-6f65-4a93-a048-8310bd2b06be

	/// Product and store pairs with zero stock on hand. Pairs with no inventory row are not stocked and are not counted.
	measure 'Out-of-Stock Count' =
			IF (
			    NOT ISBLANK ( COUNTROWS ( inventory ) ),
			    COUNTROWS ( FILTER ( inventory, inventory[Stock_On_Hand] = 0 ) ) + 0
			)
		formatString: #,0
		displayFolder: Model
		lineageTag: 2fcbf8f5-da0b-45f7-b948-83210fa75958

	/// Average daily units over the latest 90 days in 'Date' (last date minus 89 through the last date). Ignores the period filter; follows store and product filters.
	measure 'Avg Daily Units 90d' =
			VAR LastDay = CALCULATE ( MAX ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ) )
			VAR Window = FILTER ( ALL ( 'Date'[Date] ), 'Date'[Date] >= LastDay - 89 && 'Date'[Date] <= LastDay )
			RETURN
			    DIVIDE ( CALCULATE ( [Units Sold], Window, REMOVEFILTERS ( 'Date' ) ), 90 )
		formatString: #,0.0
		displayFolder: Model
		lineageTag: c1793793-376d-4640-82f5-853a3bfd84f7

	/// Stock on hand divided by average daily units over the latest 90 days.
	measure 'Days of Cover' = DIVIDE ( [Units On Hand], [Avg Daily Units 90d] )
		formatString: #,0.0
		displayFolder: Model
		lineageTag: af7d35c2-87a0-470b-9661-22026cc89771

	/// Low: under 7 days of cover, including zero stock. Overstock: over 60 days, or stock with no sales in the latest 90 days. OK: everything else. Blank where the pair is not stocked.
	measure 'Stock Status' =
			VAR OnHand = [Units On Hand]
			VAR Cover = [Days of Cover]
			RETURN
			    IF (
			        NOT ISBLANK ( OnHand ),
			        SWITCH (
			            TRUE (),
			            OnHand = 0, "Low",
			            ISBLANK ( Cover ), "Overstock",
			            Cover < 7, "Low",
			            Cover > 60, "Overstock",
			            "OK"
			        )
			    )
		displayFolder: Model
		lineageTag: 894872c6-9d55-46d5-8c61-1a2d8f9087c0

	measure 'Metric Name' = SWITCH ( SELECTEDVALUE ( Metric[Metric Order], 0 ), 1, "Profit", 2, "Units", "Revenue" )
		displayFolder: Report
		lineageTag: 686d567c-9aa9-4627-a672-bd1efea7aadc

	/// Revenue, Profit or Units Sold, from the Metric switch (field parameter column used as a plain slicer).
	measure 'Selected Metric' = SWITCH ( SELECTEDVALUE ( Metric[Metric Order], 0 ), 1, [Profit], 2, [Units Sold], [Revenue] )
		displayFolder: Report
		lineageTag: 7046b1c6-29d7-4316-8794-8b2ce0d114c9

		formatStringDefinition = IF ( SELECTEDVALUE ( Metric[Metric Order], 0 ) = 2, "#,0", "\$#,0" )

	measure 'Selected Metric PY' = CALCULATE ( [Selected Metric], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		displayFolder: Report
		lineageTag: 4a0480d9-36c3-4ed3-b691-65fcb59395c5

		formatStringDefinition = IF ( SELECTEDVALUE ( Metric[Metric Order], 0 ) = 2, "#,0", "\$#,0" )

	measure 'Selected Metric vs PY %' = DIVIDE ( [Selected Metric] - [Selected Metric PY], ABS ( [Selected Metric PY] ) )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: Report
		lineageTag: fe6ac11c-f5ca-48ea-84c9-92b732a9a6d6

	measure 'Store Count' = COUNTROWS ( stores )
		formatString: #,0
		displayFolder: Report
		lineageTag: a4053d56-ea1c-4dbd-a387-9a987082f8f4

	measure 'Selected Metric per Store' = DIVIDE ( [Selected Metric], [Store Count] )
		displayFolder: Report
		lineageTag: 301f9761-b5c5-4f14-8024-31ca5081965e

		formatStringDefinition = IF ( SELECTEDVALUE ( Metric[Metric Order], 0 ) = 2, "#,0", "\$#,0" )

	measure 'Period Label' =
			VAR _d1 = MIN ( 'Date'[Date] )
			VAR _d2 = MAX ( 'Date'[Date] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _d1 ), BLANK (),
			        MONTH ( _d1 ) = 1 && MONTH ( _d2 ) = 12 && YEAR ( _d1 ) = YEAR ( _d2 ), FORMAT ( _d1, "yyyy" ),
			        YEAR ( _d1 ) = YEAR ( _d2 ) && MONTH ( _d1 ) = MONTH ( _d2 ), FORMAT ( _d1, "mmm yyyy" ),
			        FORMAT ( _d1, "mmm" ) & "–" & FORMAT ( _d2, "mmm yyyy" )
			    )
		displayFolder: Report
		lineageTag: 6c449f66-b949-4d74-9f44-1d94688c5b9d

	measure 'Period Label PY' = CALCULATE ( [Period Label], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		displayFolder: Report
		lineageTag: 39e7ca93-a2f2-46ac-9749-561ad68b2fcd

	measure 'KPI Revenue PY text' =
			VAR _p = [Revenue PY]
			
			VAR _a = ABS ( _p )
			VAR _t =
			    SWITCH (
			        TRUE (),
			        _a >= 1e8, FORMAT ( _a / 1e6, "0" ) & "M",
			        _a >= 1e7, FORMAT ( _a / 1e6, "0.0" ) & "M",
			        _a >= 1e6, FORMAT ( _a / 1e6, "0.00" ) & "M",
			        _a >= 1e5, FORMAT ( _a / 1e3, "0" ) & "K",
			        _a >= 1e4, FORMAT ( _a / 1e3, "0.0" ) & "K",
			        _a >= 1e3, FORMAT ( _a / 1e3, "0.00" ) & "K",
			        FORMAT ( _a, "0" )
			    )
			VAR _c = IF ( _p < 0, "−", "" ) & IF ( TRUE (), "$", "" ) & _t
			RETURN
			    IF ( ISBLANK ( _p ), "First year in the data", "vs " & _c & " in " & [Period Label PY] )
		displayFolder: Report
		lineageTag: 2327b4e7-7d41-4453-bc5d-e15b8309c84c

	measure 'KPI Revenue delta text' =
			VAR _p = [Revenue PY]
			VAR _d = [Revenue vs PY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _p ), "—",
			        ROUND ( _d, 4 ) = 0, "No change",
			        _d > 0, "▲ +" & FORMAT ( ABS ( _d ), "0.0%" ),
			        "▼ −" & FORMAT ( ABS ( _d ), "0.0%" )
			    )
		displayFolder: Report
		lineageTag: ae4019f0-1712-43e3-85ad-47d37f8799c1

	measure 'KPI Revenue delta font' =
			VAR _p = [Revenue PY]
			VAR _d = [Revenue vs PY %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _p ) || ROUND ( _d, 4 ) = 0, "#5B6766", _d > 0, "#256B4D", "#B42318" )
		isHidden
		displayFolder: Report
		lineageTag: 31962d0f-f082-4b8b-b8e8-661f5930bcaa

	measure 'KPI Revenue delta background' =
			VAR _p = [Revenue PY]
