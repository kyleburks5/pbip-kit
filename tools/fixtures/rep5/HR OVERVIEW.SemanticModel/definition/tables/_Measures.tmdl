	measure 'Flow title' = "Joiners and Leavers by Month, " & MAX ( 'Date'[Year] )
		displayFolder: Rep 5
		lineageTag: 46ce8c06-1469-479c-aa70-e3f2910b114e

	measure 'Flow subtitle' =
			VAR _y = MAX ( 'Date'[Year] )
			VAR _t = ADDCOLUMNS ( GENERATESERIES ( 1, 12, 1 ), "@h", CALCULATE ( [2_Hires], FILTER ( ALL ( 'Date' ), 'Date'[Year] = _y && 'Date'[Month Number] = [Value] ) ) )
			VAR _h = SUMX ( _t, [@h] )
			VAR _x = CALCULATE ( [4_Terminations], FILTER ( ALL ( 'Date' ), 'Date'[Year] = _y ) ) + 0
			VAR _best = TOPN ( 1, _t, [@h], DESC, [Value], ASC )
			VAR _net = _h - _x
			RETURN
			    "Net " & IF ( _net > 0, "+", IF ( _net < 0, "−", "" ) ) & FORMAT ( ABS ( _net ), "#,0" ) & ": " & FORMAT ( _h, "#,0" ) & " hires, " & FORMAT ( _x, "#,0" )
			        & " terminations · most hires in " & FORMAT ( DATE ( _y, MAXX ( _best, [Value] ), 1 ), "mmm" ) & " (" & MAXX ( _best, [@h] ) & ")"
		displayFolder: Rep 5
		lineageTag: c05cf8e9-d811-4a9f-a758-71cbb98afcb5

	measure 'Flow column axis min' =
			VAR _y = MAX ( 'Date'[Year] )
			VAR _mx = MAXX ( ADDCOLUMNS ( GENERATESERIES ( 1, 12, 1 ), "@m", CALCULATE ( MAX ( COALESCE ( [2_Hires], 0 ), COALESCE ( [4_Terminations], 0 ) ), FILTER ( ALL ( 'Date' ), 'Date'[Year] = _y && 'Date'[Month Number] = [Value] ) ) ), [@m] )
			VAR _A = MAX ( _mx, 1 )
			RETURN -1.15 * _A
