		lineageTag: fe9d20f4-ffec-4761-b330-46147f280a93

	measure 'Bridge subtitle' =
			VAR _net = COALESCE ( [2_Hires], 0 ) - COALESCE ( [4_Terminations], 0 )
			RETURN
			    "Net " & IF ( _net > 0, "+", IF ( _net < 0, "−", "" ) ) & FORMAT ( ABS ( _net ), "#,0" ) & " in " & [Period label] & ": "
			        & FORMAT ( COALESCE ( [2_Hires], 0 ), "#,0" ) & " joined, " & FORMAT ( COALESCE ( [4_Terminations], 0 ), "#,0" ) & " left"
		displayFolder: Rep 5
		lineageTag: 7f0d866d-56a8-4086-816b-e4c5060dbb18

	measure 'Terminations (down)' = -[4_Terminations]
		formatString: #,0;#,0;0
