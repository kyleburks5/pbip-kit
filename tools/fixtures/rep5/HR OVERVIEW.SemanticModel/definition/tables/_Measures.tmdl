	measure 'Change dumbbell SVG' =
			VAR _o = SELECTEDVALUE ( 'Breakdown by'[Breakdown by Order], 0 )
			VAR _c = COALESCE ( [Current], 0 )
			VAR _p = COALESCE ( [Past Year], 0 )
			VAR _lo0 = SWITCH ( _o, 0, MINX ( ALLSELECTED ( 'DataTable'[Department] ), MIN ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ), 1, MINX ( ALLSELECTED ( 'DataTable'[Education level] ), MIN ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ), 2, MINX ( ALLSELECTED ( 'DataTable'[Age group] ), MIN ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ), 3, MINX ( ALLSELECTED ( 'DataTable'[EmploymentType] ), MIN ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ), 4, MINX ( ALLSELECTED ( 'DataTable'[Gender] ), MIN ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ) )
			VAR _hi0 = SWITCH ( _o, 0, MAXX ( ALLSELECTED ( 'DataTable'[Department] ), MAX ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ), 1, MAXX ( ALLSELECTED ( 'DataTable'[Education level] ), MAX ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ), 2, MAXX ( ALLSELECTED ( 'DataTable'[Age group] ), MAX ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ), 3, MAXX ( ALLSELECTED ( 'DataTable'[EmploymentType] ), MAX ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ), 4, MAXX ( ALLSELECTED ( 'DataTable'[Gender] ), MAX ( COALESCE ( [Current], 0 ), COALESCE ( [Past Year], 0 ) ) ) )
			VAR _pad = MAX ( ( _hi0 - _lo0 ) * 0.08, 1 )
			VAR _lo = _lo0 - _pad
			VAR _hi = _hi0 + _pad
			VAR _xc = 10 + ( _c - _lo ) / ( _hi - _lo ) * 200
			VAR _xp = 10 + ( _p - _lo ) / ( _hi - _lo ) * 200
			VAR _d = _c - _p
			VAR _col = SWITCH (
			        TRUE (),
			        ISBLANK ( _d ) || _d = 0, "%235D6B8A",
			        SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", "%235D6B8A",
			        SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Terminations", IF ( _d > 0, "%23A84545", "%23038D96" ),
			        IF ( _d > 0, "%23038D96", "%23A84545" )
			    )
			VAR _pct = IF ( _p <> 0, IF ( _d > 0, "+", IF ( _d < 0, "−", "" ) ) & FORMAT ( ABS ( _d / _p ) * 100, "0.0" ) & "%25", "" )  -- a raw % breaks the data URI
			RETURN
			    IF (
			        [Has PY] && ( _c <> 0 || _p <> 0 ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='270' height='24' viewBox='0 0 270 24'>"
			            & "<line x1='" & FORMAT ( _xp, "0.0" ) & "' x2='" & FORMAT ( _xc, "0.0" ) & "' y1='12' y2='12' stroke='" & _col
			            & "' stroke-width='4' stroke-opacity='0.45'/>"
			            & "<circle cx='" & FORMAT ( _xp, "0.0" ) & "' cy='12' r='6' fill='white' stroke='%235D6B8A' stroke-width='2'/>"
			            & "<circle cx='" & FORMAT ( _xc, "0.0" ) & "' cy='12' r='7' fill='" & _col & "'/>"
			            & "<text x='266' y='16' font-size='11' font-family='Segoe UI' text-anchor='end' fill='%235A6577'>" & _pct & "</text></svg>"
			    )
		displayFolder: Rep 5
		lineageTag: 32fe4de2-d75b-448b-940e-fb157a116acd
		dataCategory: ImageUrl

	measure 'Change subtitle' =
			VAR _o = SELECTEDVALUE ( 'Breakdown by'[Breakdown by Order], 0 )
			VAR _c = COALESCE ( [Current], 0 )
			VAR _p = COALESCE ( [Past Year], 0 )
			VAR _d = _c - _p
			VAR _extra =
			    SWITCH (
			        _o,
			        0,
			            VAR _t = ADDCOLUMNS ( VALUES ( 'DataTable'[Department] ), "@d", COALESCE ( [Current], 0 ) - COALESCE ( [Past Year], 0 ) )
			            VAR _up = TOPN ( 1, FILTER ( _t, [@d] > 0 ), [@d], DESC, 'DataTable'[Department], ASC )
			            VAR _dn = TOPN ( 1, FILTER ( _t, [@d] < 0 ), [@d], ASC, 'DataTable'[Department], ASC )
			            RETURN
			                IF ( NOT ISEMPTY ( _up ), " · biggest rise " & MAXX ( _up, 'DataTable'[Department] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MAXX ( _up, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MAXX ( _up, [@d] ) ), "#,0" ) ) )
			                    & IF ( NOT ISEMPTY ( _dn ), " · biggest fall " & MAXX ( _dn, 'DataTable'[Department] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MINX ( _dn, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MINX ( _dn, [@d] ) ), "#,0" ) ) ),
			        1,
			            VAR _t = ADDCOLUMNS ( VALUES ( 'DataTable'[Education level] ), "@d", COALESCE ( [Current], 0 ) - COALESCE ( [Past Year], 0 ) )
			            VAR _up = TOPN ( 1, FILTER ( _t, [@d] > 0 ), [@d], DESC, 'DataTable'[Education level], ASC )
			            VAR _dn = TOPN ( 1, FILTER ( _t, [@d] < 0 ), [@d], ASC, 'DataTable'[Education level], ASC )
			            RETURN
			                IF ( NOT ISEMPTY ( _up ), " · biggest rise " & MAXX ( _up, 'DataTable'[Education level] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MAXX ( _up, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MAXX ( _up, [@d] ) ), "#,0" ) ) )
			                    & IF ( NOT ISEMPTY ( _dn ), " · biggest fall " & MAXX ( _dn, 'DataTable'[Education level] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MINX ( _dn, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MINX ( _dn, [@d] ) ), "#,0" ) ) ),
			        2,
			            VAR _t = ADDCOLUMNS ( VALUES ( 'DataTable'[Age group] ), "@d", COALESCE ( [Current], 0 ) - COALESCE ( [Past Year], 0 ) )
			            VAR _up = TOPN ( 1, FILTER ( _t, [@d] > 0 ), [@d], DESC, 'DataTable'[Age group], ASC )
			            VAR _dn = TOPN ( 1, FILTER ( _t, [@d] < 0 ), [@d], ASC, 'DataTable'[Age group], ASC )
			            RETURN
			                IF ( NOT ISEMPTY ( _up ), " · biggest rise " & MAXX ( _up, 'DataTable'[Age group] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MAXX ( _up, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MAXX ( _up, [@d] ) ), "#,0" ) ) )
			                    & IF ( NOT ISEMPTY ( _dn ), " · biggest fall " & MAXX ( _dn, 'DataTable'[Age group] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MINX ( _dn, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MINX ( _dn, [@d] ) ), "#,0" ) ) ),
			        3,
			            VAR _t = ADDCOLUMNS ( VALUES ( 'DataTable'[EmploymentType] ), "@d", COALESCE ( [Current], 0 ) - COALESCE ( [Past Year], 0 ) )
			            VAR _up = TOPN ( 1, FILTER ( _t, [@d] > 0 ), [@d], DESC, 'DataTable'[EmploymentType], ASC )
			            VAR _dn = TOPN ( 1, FILTER ( _t, [@d] < 0 ), [@d], ASC, 'DataTable'[EmploymentType], ASC )
			            RETURN
			                IF ( NOT ISEMPTY ( _up ), " · biggest rise " & MAXX ( _up, 'DataTable'[EmploymentType] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MAXX ( _up, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MAXX ( _up, [@d] ) ), "#,0" ) ) )
			                    & IF ( NOT ISEMPTY ( _dn ), " · biggest fall " & MAXX ( _dn, 'DataTable'[EmploymentType] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MINX ( _dn, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MINX ( _dn, [@d] ) ), "#,0" ) ) ),
			        4,
			            VAR _t = ADDCOLUMNS ( VALUES ( 'DataTable'[Gender] ), "@d", COALESCE ( [Current], 0 ) - COALESCE ( [Past Year], 0 ) )
			            VAR _up = TOPN ( 1, FILTER ( _t, [@d] > 0 ), [@d], DESC, 'DataTable'[Gender], ASC )
			            VAR _dn = TOPN ( 1, FILTER ( _t, [@d] < 0 ), [@d], ASC, 'DataTable'[Gender], ASC )
			            RETURN
			                IF ( NOT ISEMPTY ( _up ), " · biggest rise " & MAXX ( _up, 'DataTable'[Gender] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MAXX ( _up, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MAXX ( _up, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MAXX ( _up, [@d] ) ), "#,0" ) ) )
			                    & IF ( NOT ISEMPTY ( _dn ), " · biggest fall " & MAXX ( _dn, 'DataTable'[Gender] ) & " " & IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & "$" & FORMAT ( ABS ( MINX ( _dn, [@d] ) ) / 1e6, "0.0" ) & "M", IF ( MINX ( _dn, [@d] ) > 0, "+", "−" ) & FORMAT ( ABS ( MINX ( _dn, [@d] ) ), "#,0" ) ) )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( MIN ( 'Date'[Date] ) ), "No data for this selection",
			        NOT [Has PY], YEAR ( MIN ( 'Date'[Date] ) ) & " is the first year of data: choose 2021 or later to compare",
			        SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) & " " & IF ( _d = 0, "no change", IF ( SELECTEDVALUE ( 'Metric Selection'[Selected_KPI] ) = "Salary", IF ( _d > 0, "+", "−" ) & "$" & FORMAT ( ABS ( _d ) / 1e6, "0.0" ) & "M", IF ( _d > 0, "+", "−" ) & FORMAT ( ABS ( _d ), "#,0" ) ) & IF ( _p <> 0, " (" & IF ( _d > 0, "+", IF ( _d < 0, "−", "" ) ) & FORMAT ( ABS ( _d / _p ), "0.0%" ) & ")" ) )
			            & " vs " & [Period label LY] & _extra
			    )
		displayFolder: Rep 5
		lineageTag: 4a84a3a6-a406-44dc-8c61-310c3ae91860

	measure 'Departments table HTML' = ```
			VAR _all = [Termination rate from 2021]
			VAR _t = ADDCOLUMNS ( VALUES ( 'DataTable'[Department] ), "@hc", [1_Headcount], "@h", [2_Hires], "@x", [4_Terminations], "@s", [3_TotalSalary] )
			VAR _mxhc = MAX ( MAXX ( _t, [@hc] ), 1 )
			VAR _mxs = MAX ( MAXX ( _t, [@s] ), 1 )
			VAR _mxht = MAX ( MAX ( MAXX ( _t, [@h] ), MAXX ( _t, [@x] ) ), 1 )
			VAR _rows =
			    CONCATENATEX (
			        FILTER ( _t, [@hc] + [@h] + [@x] > 0 ),
			        
			            VAR _hc = COALESCE ( [1_Headcount], 0 )
			            VAR _h = COALESCE ( [2_Hires], 0 )
			            VAR _x = COALESCE ( [4_Terminations], 0 )
			            VAR _r = [Termination rate from 2021]
			            VAR _n = _h - _x
			            RETURN
			                "<tr style='height:40px;border-bottom:1px solid #EEF1F6'><td>" & 'DataTable'[Department] & "</td><td style='text-align:right'>" & FORMAT ( _hc, "#,0" )
			                    & "<span style='display:inline-block;height:8px;border-radius:4px;margin-left:10px;background:#8CCFD3;width:" & FORMAT ( _hc / _mxhc * 100, "0" ) & "px'></span>" & "</td><td style='text-align:center;white-space:nowrap'><span style='color:#A84545'>" & _x & "</span> "
			                    & "<span style='display:inline-block;width:70px;text-align:right'><span style='display:inline-block;height:8px;border-radius:4px 0 0 4px;background:#A84545;width:" & FORMAT ( _x / _mxht * 70, "0" ) & "px'></span></span>"
			                    & "<span style='display:inline-block;width:1px;height:16px;background:#5A6577;vertical-align:middle'></span>"
			                    & "<span style='display:inline-block;width:70px'><span style='display:inline-block;height:8px;border-radius:0 4px 4px 0;background:#038D96;width:" & FORMAT ( _h / _mxht * 70, "0" ) & "px'></span></span> "
			                    & "<span style='color:#026E75'>" & _h & "</span></td>"
			                    & "<td style='text-align:center'><span style='padding:0 8px;border-radius:10px;font-weight:600;" & IF ( NOT ISBLANK ( _r ) && _r > _all, "background:#F6EDED;color:#A84545", "background:#EEF1F6;color:#5A6577" ) & "'>"
			                    & IF ( ISBLANK ( _r ), "–", FORMAT ( _r, "0.0%" ) ) & "</span></td>"
			                    & "<td style='text-align:right;font-weight:600;color:" & IF ( _n < 0, "#A84545", IF ( _n > 0, "#026E75", "#1D2733" ) ) & "'>"
			                    & IF ( _n > 0, "+", IF ( _n < 0, "−", "" ) ) & FORMAT ( ABS ( _n ), "#,0" ) & "</td><td style='text-align:right'>" & "$" & FORMAT ( [Average Salary] / 1e3, "0.0" ) & "K"
			                    & "</td><td style='text-align:right'>" & FORMAT ( [3_TotalSalary], "\$#,0" ) & "<span style='display:inline-block;height:8px;border-radius:4px;margin-left:10px;background:#B8C2D6;width:" & FORMAT ( [@s] / _mxs * 46, "0" ) & "px'></span>" & "</td></tr>",
			        "", [@hc], DESC
			    )
			VAR _total =
			    VAR _x = COALESCE ( [4_Terminations], 0 )
			    VAR _h = COALESCE ( [2_Hires], 0 )
			    VAR _n = _h - _x
			    RETURN
			        "<tr style='height:40px;font-weight:600;border-top:1.5px solid #12343B'><td>All Departments</td><td style='text-align:right'>"
			            & FORMAT ( COALESCE ( [1_Headcount], 0 ), "#,0" ) & "</td><td style='text-align:center'><span style='color:#A84545'>" & _x
			            & "</span> / <span style='color:#026E75'>" & _h & "</span></td><td style='text-align:center'>"
			            & IF ( ISBLANK ( _all ), "–", FORMAT ( _all, "0.0%" ) ) & "</td><td style='text-align:right'>" & IF ( _n > 0, "+", IF ( _n < 0, "−", "" ) ) & FORMAT ( ABS ( _n ), "#,0" )
			            & "</td><td style='text-align:right'>" & "$" & FORMAT ( [Average Salary] / 1e3, "0.0" ) & "K" & "</td><td style='text-align:right'>"
			            & FORMAT ( [3_TotalSalary], "\$#,0" ) & "</td></tr>"
			RETURN
			    "<table style='width:100%;border-collapse:collapse;font-family:Segoe UI;font-size:13px;color:#1D2733'>"
			        & "<tr style='height:26px;background:#EEF1F6;color:#5A6577;font-size:12px;font-weight:600'>"
			        & "<td>Department</td><td style='text-align:right'>Headcount</td><td style='text-align:center'>Terminations ◂ | ▸ Hires</td>"
			        & "<td style='text-align:center'>Termination Rate</td><td style='text-align:right'>Net Change</td>"
			        & "<td style='text-align:right'>Avg Salary</td><td style='text-align:right'>Total Salary</td></tr>"
			        & _rows & _total & "</table>"
			```
		displayFolder: Rep 5
		lineageTag: 93ba3b91-0819-4a94-ada9-8a1ccd8f1372

	measure 'Departments subtitle' =
			VAR _all = [Termination rate from 2021]
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( 'DataTable'[Department] ), "@r", [Termination rate from 2021], "@x", [4_Terminations] ), [@x] > 0 )
			VAR _hi = TOPN ( 1, _t, [@r], DESC, 'DataTable'[Department], ASC )
			RETURN
			    "End of " & [Period label] & " · "
			        & SWITCH (
			            TRUE (),
			            ISBLANK ( _all ), "rates start in 2021",
			            ISEMPTY ( _hi ), "no terminations in the period",
			            "highest termination rate " & MAXX ( _hi, 'DataTable'[Department] ) & " " & FORMAT ( MAXX ( _hi, [@r] ), "0.0%" )
			                & ", all departments " & FORMAT ( _all, "0.0%" ) & " · red = above"
			        )
		displayFolder: Rep 5
		lineageTag: f2b42a82-ccb4-4851-b382-66b3dc580ba4

