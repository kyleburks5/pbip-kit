	measure '1_Headcount BG Color' = ```
			
			    VAR _Delta = '_Measures'[1_Headcount] - '_Measures'[1_Headcount LY]
			    RETURN
			        SWITCH(
			            TRUE(),
			            _Delta > 0, "#E7F3F5",  
			            _Delta = 0, "FFFFFF00",  
			            _Delta < 0, "#F6EDED"   
			        )
			 
			
			```
		isHidden
		lineageTag: a016b997-bf56-4208-8368-9403a617b117

	measure '1_Headcount Font Color' = ```
			
			    VAR _Delta = '_Measures'[1_Headcount] - '_Measures'[1_Headcount LY]
			    RETURN
			        SWITCH(
			            TRUE(),
			            _Delta > 0, "#038D96",  
			            _Delta = 0, "FFFFFF00",  
			            _Delta < 0, "#A84545"   
			        )
			
			
			```
		isHidden
		lineageTag: a74bfaab-329e-4a5f-8be5-d140e60e3d7b

	measure '1_Headcount Reference' = ```
			
			    VAR _Current = '_Measures'[1_Headcount]
			    VAR _LY = '_Measures'[1_Headcount LY]
			    VAR _Growth = DIVIDE(_Current - _LY, _LY)
			    VAR NumOfDigits = IFERROR(LEN(CONVERT(INT(_Current), STRING)), 0)
			    VAR Suffix = ".0" & SWITCH(TRUE(), NumOfDigits >= 13, "T", NumOfDigits >= 10, "B", NumOfDigits >= 7, "M", NumOfDigits >= 4, "K")
			    VAR Commas = REPT(",", SWITCH(TRUE(), NumOfDigits >= 13, "4", NumOfDigits >= 10, "3", NumOfDigits >= 7, "2", NumOfDigits >= 4, "1"))
			    VAR _Format = "#,##0" & Commas & Suffix & ";-#,##0" & Commas & Suffix 
			    RETURN
			        IF(_Growth <> 0, FORMAT(_Current - _LY, _Format) & FORMAT(_Growth, " | 0.0% ▲; | 0.0% ▼; ") & " YoY", BLANK())
			
			
			```
		isHidden
		lineageTag: bbf13d1b-830d-4b8d-900f-31aa024142fa

