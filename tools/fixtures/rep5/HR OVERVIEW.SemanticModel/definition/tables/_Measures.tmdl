	measure 'Headcount sparkline SVG' =
			VAR _y = MAX ( 'Date'[Year] )
			VAR _m2 = MONTH ( MAX ( 'Date'[Date] ) )
			VAR _pts = ADDCOLUMNS ( GENERATESERIES ( 1, 12, 1 ), "@hc", CALCULATE ( [1_Headcount], FILTER ( ALL ( 'Date' ), 'Date'[Year] = _y && 'Date'[Month Number] = [Value] ) ) )
			VAR _lo = MINX ( _pts, [@hc] )
			VAR _hi = MAXX ( _pts, [@hc] )
			VAR _r = IF ( _hi = _lo, 1, _hi - _lo )
			VAR _xy = ADDCOLUMNS ( _pts, "@x", 4 + ( [Value] - 1 ) * 10, "@y", 58 - ( [@hc] - _lo ) / _r * 48 )
			VAR _line = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [Value], ASC )
			VAR _lx = MAXX ( FILTER ( _xy, [Value] = _m2 ), [@x] )
			VAR _ly = MAXX ( FILTER ( _xy, [Value] = _m2 ), [@y] )
			RETURN
			    IF (
			        NOT ISBLANK ( _hi ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='118' height='64' viewBox='0 0 118 64'>"
			            & "<polygon points='4,64 " & _line & " 114,64' fill='%23038D96' fill-opacity='0.35'/>"
			            & "<polyline points='" & _line & "' fill='none' stroke='%238CCFD3' stroke-width='2'/>"
			            & "<circle cx='" & FORMAT ( _lx, "0.0" ) & "' cy='" & FORMAT ( _ly, "0.0" ) & "' r='4' fill='white'/></svg>"
			    )
		displayFolder: Rep 5
		lineageTag: 5d5e396c-6cf1-4986-b885-2d5283d531b4
		dataCategory: ImageUrl

	measure 'Termination rate bars SVG' =
			VAR _sel = MAX ( 'Date'[Year] )
			VAR _t = ADDCOLUMNS ( GENERATESERIES ( 2021, 2024, 1 ), "@r",
			    CALCULATE ( [Termination rate from 2021], FILTER ( ALL ( 'Date' ), 'Date'[Year] = [Value] ) ) )
			VAR _mx = MAX ( MAXX ( _t, [@r] ), 0.01 )
			VAR _bars =
			    CONCATENATEX (
			        _t,
			        VAR _h = COALESCE ( [@r], 0 ) / _mx * 50
			        VAR _x = ( [Value] - 2021 ) * 30 + 4
			        VAR _on = [Value] = _sel
			        RETURN
			            "<rect x='" & _x & "' y='" & FORMAT ( 62 - _h, "0.0" ) & "' width='22' height='" & FORMAT ( _h, "0.0" )
			                & "' rx='3' fill='" & IF ( _on, "%23A84545", "%23E3A6A6" ) & "'/>"
			                & IF ( _on, "<text x='" & _x + 11 & "' y='" & FORMAT ( 58 - _h, "0.0" ) & "' font-size='10' font-family='Segoe UI' "
			                    & "font-weight='600' fill='%23A84545' text-anchor='middle'>" & FORMAT ( [@r] * 100, "0.0" ) & "%25</text>" )
			                & "<text x='" & _x + 11 & "' y='75' font-size='10' font-family='Segoe UI' text-anchor='middle' fill='"
			                & IF ( _on, "%231D2733", "%235A6577" ) & "'>" & RIGHT ( [Value], 2 ) & "</text>",
			        "", [Value], ASC
			    )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='118' height='78' viewBox='0 0 118 78'>" & _bars & "</svg>"
		displayFolder: Rep 5
		lineageTag: 69beeb8d-6fea-4434-9ce2-770d79b90ece
		dataCategory: ImageUrl

	measure 'Terminations card HTML' =
			VAR _y = MAX ( 'Date'[Year] )
			VAR _m1 = MONTH ( MIN ( 'Date'[Date] ) )
			VAR _m2 = MONTH ( MAX ( 'Date'[Date] ) )
			VAR _t = ADDCOLUMNS ( GENERATESERIES ( 1, 12, 1 ), "@t", CALCULATE ( [4_Terminations], FILTER ( ALL ( 'Date' ), 'Date'[Year] = _y && 'Date'[Month Number] = [Value] ) ) )
			VAR _mx = MAX ( MAXX ( _t, [@t] ), 1 )
			VAR _busy = TOPN ( 1, _t, [@t], DESC, [Value], ASC )
			VAR _bars =
			    CONCATENATEX (
			        _t,
			        "<div title='" & FORMAT ( DATE ( _y, [Value], 1 ), "mmm" ) & ": " & COALESCE ( [@t], 0 ) & "' style='flex:1;border-radius:2px;height:"
			            & MAX ( 2, COALESCE ( [@t], 0 ) / _mx * 52 ) & "px;background:"
			            & IF ( [Value] >= _m1 && [Value] <= _m2, "#A84545", "#E3A6A6" ) & "'></div>",
			        "", [Value], ASC
			    )
			RETURN
			    "<div style='font-family:Segoe UI;position:relative;height:100%'>"
			        & "<div style='font-size:13px;font-weight:600;color:#5A6577'>Terminations</div>"
			        & "<div style='font-size:36px;font-weight:600;color:#A84545;line-height:44px'>" & FORMAT ( COALESCE ( [4_Terminations], 0 ), "#,0" ) & "</div>"
			        & "<div style='font-size:12px;color:#5A6577;margin-top:8px'><span style='padding:0 8px;border-radius:11px;font-weight:600;"
			        & "background:" & [KPI Terminations delta background] & ";color:" & [KPI Terminations delta font] & "'>"
			        & COALESCE ( [KPI Terminations delta text], "First year" ) & "</span> " & IF ( [Has PY], "vs " & COALESCE ( [4_Terminations LY], 0 ) ) & "</div>"
			        & "<div style='position:absolute;right:0;top:6px;width:118px'><div style='display:flex;align-items:flex-end;gap:3px;height:52px'>"
			        & _bars & "</div><div style='font-size:11px;color:#5A6577;text-align:right;margin-top:6px'>"
			        & IF ( MAXX ( _t, [@t] ) > 0, "busiest " & FORMAT ( DATE ( _y, MAXX ( _busy, [Value] ), 1 ), "mmm" ) & " (" & MAXX ( _busy, [@t] ) & ")", "none this year" )
			        & "</div></div></div>"
		displayFolder: Rep 5
		lineageTag: 5e406427-4582-4c47-b6b8-c7aebb45acaf

	measure Headline =
			VAR _hc = [1_Headcount]
			VAR _net = COALESCE ( [2_Hires], 0 ) - COALESCE ( [4_Terminations], 0 )
			VAR _r = [Termination rate from 2021]
			VAR _rl = [Termination rate from 2021 LY]
			VAR _pts = ( _r - _rl ) * 100
			RETURN
			    IF (
			        ISBLANK ( MIN ( 'Date'[Date] ) ), "No data for this selection",
			        FORMAT ( COALESCE ( _hc, 0 ), "#,0" ) & " employees at the end of " & [Period label] & " · net "
			            & IF ( _net > 0, "+", IF ( _net < 0, "−", "" ) ) & FORMAT ( ABS ( _net ), "#,0" ) & " (" & FORMAT ( COALESCE ( [2_Hires], 0 ), "#,0" ) & " joined, "
			            & FORMAT ( COALESCE ( [4_Terminations], 0 ), "#,0" ) & " left)"
			            & SWITCH (
			                TRUE (),
			                ISBLANK ( _r ), " · first year of data, rates start in 2021",
			                ISBLANK ( _rl ), " · termination rate " & FORMAT ( _r, "0.0%" ),
			                " · termination rate " & FORMAT ( _r, "0.0%" ) & ", " & IF ( _pts < 0, "down ", "up " )
			                    & FORMAT ( ABS ( _pts ), "0.0" ) & " pts"
			            )
			    )
		displayFolder: Rep 5
		lineageTag: d255257c-6d2e-4541-afd4-826dccf30220

	measure 'Headline Mix' =
			VAR _hc = [1_Headcount]
			VAR _c = CALCULATE ( [1_Headcount], 'DataTable'[EmploymentType] = "Contractor" )
			RETURN
			    IF (
			        COALESCE ( _hc, 0 ) = 0, "No active employees in this selection",
			        FORMAT ( _hc, "#,0" ) & " active employees at the end of " & [Period label] & " · "
			            & FORMAT ( DIVIDE ( _c, _hc, 0 ), "0.0%" ) & " contractors · average salary " & "$" & FORMAT ( [Average Salary] / 1e3, "0.0" ) & "K"
			    )
		displayFolder: Rep 5
		lineageTag: 0c38f983-874f-44c7-b61e-a8ceb29ff2a6

	/// Transparent base series that floats the hires and terminations bars.
	measure 'Bridge base' =
			VAR _o = SELECTEDVALUE ( 'Bridge step'[Order], 0 )
			RETURN
			    SWITCH ( _o, 2, [Headcount Start], 3, COALESCE ( [Headcount Start], 0 ) + COALESCE ( [2_Hires], 0 ) - COALESCE ( [4_Terminations], 0 ) )
		formatString: ;;;
		isHidden
		displayFolder: Rep 5
		lineageTag: 25dc8e05-6fa5-4adc-b8d1-e8d0c0498979

	measure 'Bridge level' = VAR _o = SELECTEDVALUE ( 'Bridge step'[Order], 0 ) RETURN SWITCH ( _o, 1, COALESCE ( [Headcount Start], 0 ), 4, [1_Headcount] )
		formatString: #,0
		displayFolder: Rep 5
		lineageTag: 02c444d8-3b8a-4233-a250-cd4fcad73a51

	measure 'Bridge up' = IF ( SELECTEDVALUE ( 'Bridge step'[Order], 0 ) = 2, [2_Hires] )
		formatString: +#,0;-#,0;0
		displayFolder: Rep 5
		lineageTag: 9a337e60-b43c-4000-a02c-1892bebb011a

	measure 'Bridge down' = IF ( SELECTEDVALUE ( 'Bridge step'[Order], 0 ) = 3, COALESCE ( [4_Terminations], 0 ) )
		formatString: −#,0;−#,0;0
