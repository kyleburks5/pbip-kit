	measure 'Sentiment subtitle' =
			VAR _A = COALESCE ( [1_Headcount], 0 )
			VAR _L = COALESCE ( [Leavers to date], 0 )
			VAR _g00 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "Low" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "Low" ), _A, 0 )
			VAR _g01 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "Medium" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "Medium" ), _A, 0 )
			VAR _g02 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "High" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "High" ), _A, 0 )
			VAR _g03 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "Very High" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "Very High" ), _A, 0 )
			VAR _g10 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Performance rating] = "Low" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Performance rating] = "Low" ), _A, 0 )
			VAR _g11 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Performance rating] = "Good" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Performance rating] = "Good" ), _A, 0 )
			VAR _g12 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Performance rating] = "Excellent" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Performance rating] = "Excellent" ), _A, 0 )
			VAR _g13 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Performance rating] = "Outstanding" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Performance rating] = "Outstanding" ), _A, 0 )
			VAR _g20 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Work-life balance] = "Bad" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Work-life balance] = "Bad" ), _A, 0 )
			VAR _g21 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Work-life balance] = "Good" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Work-life balance] = "Good" ), _A, 0 )
			VAR _g22 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Work-life balance] = "Better" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Work-life balance] = "Better" ), _A, 0 )
			VAR _g23 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Work-life balance] = "Best" ), _L, 0 ) - DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Work-life balance] = "Best" ), _A, 0 )
			VAR _t = { ( "Job Satisfaction", "Low", _g00, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "Low" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "Low" ), _A, 0 ) ), ( "Job Satisfaction", "Medium", _g01, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "Medium" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "Medium" ), _A, 0 ) ), ( "Job Satisfaction", "High", _g02, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "High" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "High" ), _A, 0 ) ), ( "Job Satisfaction", "Very High", _g03, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "Very High" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "Very High" ), _A, 0 ) ), ( "Performance Rating", "Low", _g10, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Performance rating] = "Low" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Performance rating] = "Low" ), _A, 0 ) ), ( "Performance Rating", "Good", _g11, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Performance rating] = "Good" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Performance rating] = "Good" ), _A, 0 ) ), ( "Performance Rating", "Excellent", _g12, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Performance rating] = "Excellent" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Performance rating] = "Excellent" ), _A, 0 ) ), ( "Performance Rating", "Outstanding", _g13, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Performance rating] = "Outstanding" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Performance rating] = "Outstanding" ), _A, 0 ) ), ( "Work-Life Balance", "Bad", _g20, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Work-life balance] = "Bad" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Work-life balance] = "Bad" ), _A, 0 ) ), ( "Work-Life Balance", "Good", _g21, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Work-life balance] = "Good" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Work-life balance] = "Good" ), _A, 0 ) ), ( "Work-Life Balance", "Better", _g22, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Work-life balance] = "Better" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Work-life balance] = "Better" ), _A, 0 ) ), ( "Work-Life Balance", "Best", _g23, DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Work-life balance] = "Best" ), _L, 0 ), DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Work-life balance] = "Best" ), _A, 0 ) ) }
			VAR _top = TOPN ( 1, _t, ABS ( [Value3] ), DESC )
			RETURN
			    SWITCH (
			        TRUE (),
			        _A + _L = 0, "No data for this selection",
			        _L = 0, "No leavers by the end of " & [Period label],
			        "Biggest gap: " & MAXX ( _top, [Value1] ) & " “" & MAXX ( _top, [Value2] ) & "”, " & FORMAT ( MAXX ( _top, [Value4] ), "0%" )
			            & " of the " & FORMAT ( _L, "#,0" ) & " leavers vs " & FORMAT ( MAXX ( _top, [Value5] ), "0%" )
			            & " of active · small numbers, read as a pattern"
			    )
		displayFolder: Rep 5
		lineageTag: c50e5fcb-64f5-4011-8ec4-8ea04b713f32

	measure 'Salary box SVG' =
			VAR _d = MAX ( 'Date'[Date] )
			VAR _s =
			    SELECTCOLUMNS (
			        FILTER ( 'DataTable', 'DataTable'[HireDate] <= _d && ( ISBLANK ( 'DataTable'[TerminationDate] ) || 'DataTable'[TerminationDate] > _d ) ),
			        "@s", 'DataTable'[Salary]
			    )
			VAR _min = MINX ( _s, [@s] )
			VAR _max = MAXX ( _s, [@s] )
			VAR _q1 = PERCENTILEX.INC ( _s, [@s], 0.25 )
			VAR _md = PERCENTILEX.INC ( _s, [@s], 0.5 )
			VAR _q3 = PERCENTILEX.INC ( _s, [@s], 0.75 )
			VAR _avg = AVERAGEX ( _s, [@s] )
			VAR _grid =
			    CONCATENATEX (
			        { 50000, 100000, 150000, 200000 },
			        "<line x1='" & FORMAT ( 8 + ( [Value] - 40000 ) / 160000 * 284, "0.0" ) & "' x2='" & FORMAT ( 8 + ( [Value] - 40000 ) / 160000 * 284, "0.0" ) & "' y1='4' y2='40' stroke='%23EEF1F6'/>"
			            & "<text x='" & FORMAT ( 8 + ( [Value] - 40000 ) / 160000 * 284, "0.0" ) & "' y='51' font-size='9' font-family='Segoe UI' text-anchor='middle' fill='%23B8C2D6'>$"
			            & [Value] / 1000 & "K</text>",
			        ""
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _min ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='52' viewBox='0 0 300 52'>" & _grid
			            & "<line x1='" & FORMAT ( 8 + ( _min - 40000 ) / 160000 * 284, "0.0" ) & "' x2='" & FORMAT ( 8 + ( _max - 40000 ) / 160000 * 284, "0.0" ) & "' y1='26' y2='26' stroke='%235D6B8A' stroke-width='1.5'/>"
			            & "<line x1='" & FORMAT ( 8 + ( _min - 40000 ) / 160000 * 284, "0.0" ) & "' x2='" & FORMAT ( 8 + ( _min - 40000 ) / 160000 * 284, "0.0" ) & "' y1='19' y2='33' stroke='%235D6B8A' stroke-width='1.5'/>"
			            & "<line x1='" & FORMAT ( 8 + ( _max - 40000 ) / 160000 * 284, "0.0" ) & "' x2='" & FORMAT ( 8 + ( _max - 40000 ) / 160000 * 284, "0.0" ) & "' y1='19' y2='33' stroke='%235D6B8A' stroke-width='1.5'/>"
			            & "<rect x='" & FORMAT ( 8 + ( _q1 - 40000 ) / 160000 * 284, "0.0" ) & "' y='15' width='" & FORMAT ( ( _q3 - _q1 ) / 160000 * 284, "0.0" ) & "' height='22' rx='4' fill='%23B8C2D6'/>"
			            & "<line x1='" & FORMAT ( 8 + ( _md - 40000 ) / 160000 * 284, "0.0" ) & "' x2='" & FORMAT ( 8 + ( _md - 40000 ) / 160000 * 284, "0.0" ) & "' y1='15' y2='37' stroke='%2312343B' stroke-width='2.5'/>"
			            & "<circle cx='" & FORMAT ( 8 + ( _avg - 40000 ) / 160000 * 284, "0.0" ) & "' cy='26' r='4.5' fill='%23038D96' stroke='white' stroke-width='1.5'/></svg>"
			    )
		displayFolder: Rep 5
		lineageTag: 54f50e5e-e7d6-44c1-902b-427273aa9c1c
		dataCategory: ImageUrl

	measure 'Pay subtitle' =
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( 'DataTable'[JobRole] ), "@a", [Average Salary] ), NOT ISBLANK ( [@a] ) )
			RETURN
			    IF ( ISEMPTY ( _t ), "No data for this selection",
			        "All roles " & "$" & FORMAT ( [Average Salary] / 1e3, "0.0" ) & "K" & " average · role averages " & "$" & FORMAT ( MINX ( _t, [@a] ) / 1e3, "0.0" ) & "K" & "–"
			            & "$" & FORMAT ( MAXX ( _t, [@a] ) / 1e3, "0.0" ) & "K" & ", the spread inside each role is far wider" )
		displayFolder: Rep 5
		lineageTag: 241e3297-636b-4bd2-9f72-585c4149528f

