	measure 'Heatmap subtitle' =
			VAR _t = ADDCOLUMNS ( CROSSJOIN ( VALUES ( 'DataTable'[Age group] ), VALUES ( 'DataTable'[Education level] ) ), "@n", [1_Headcount] )
			VAR _top = TOPN ( 1, _t, [@n], DESC, 'DataTable'[Age group], ASC, 'DataTable'[Education level], ASC )
			RETURN
			    IF ( COALESCE ( [1_Headcount], 0 ) = 0, "No data for this selection",
			        "Active employees, end of " & [Period label] & " · largest group " & MAXX ( _top, 'DataTable'[Age group] ) & ", "
			            & MAXX ( _top, 'DataTable'[Education level] ) & " (" & MAXX ( _top, [@n] ) & ")" )
