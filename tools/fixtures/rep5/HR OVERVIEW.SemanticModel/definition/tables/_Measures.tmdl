	measure 'Termination rate from 2021 LY' = CALCULATE ( [Termination rate from 2021], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.0%
		displayFolder: Rep 5
		lineageTag: 048ab105-f02c-4d69-9595-eec730244e57

	/// Pane slicers with a selection (Year not counted). Charts don't filter the badge (interactions None).
	measure 'Filter count' =
			INT ( ISFILTERED ( 'Date'[Quarter] ) ) + INT ( ISFILTERED ( 'Date'[Month] ) )
			    + INT ( ISFILTERED ( 'DataTable'[Department] ) ) + INT ( ISFILTERED ( 'DataTable'[EmploymentType] ) )
			    + INT ( ISFILTERED ( 'DataTable'[Gender] ) )
		formatString: 0
		isHidden
		displayFolder: Rep 5
		lineageTag: 7b7a0102-bea2-4206-ae9f-6f31b10c41a1

	measure 'Filter badge' = VAR _n = [Filter count] RETURN IF ( _n = 0, "", FORMAT ( _n, "0" ) )
		displayFolder: Rep 5
		lineageTag: 3743980f-3976-4c53-a615-4939616e115c

	measure 'Filter count text' = VAR _n = [Filter count] RETURN IF ( _n = 0, "none applied", _n & " applied" )
		displayFolder: Rep 5
		lineageTag: 9e1d9b43-ce8a-4e09-a473-52b447ec848b

	measure 'Filter badge fill' = IF ( [Filter count] = 0, "#FFFFFF00", "#038D96" )
		isHidden
		displayFolder: Rep 5
		lineageTag: ab932c88-3cb2-46cc-bd09-396f83f9620b

	measure 'KPI Headcount PY text' = IF ( NOT [Has PY], "First year of data", "vs " & FORMAT ( COALESCE ( [1_Headcount LY], 0 ), "#,0" ) & " in " & [Period label LY] )
		displayFolder: Rep 5
		lineageTag: 9602c8cf-a0ee-4493-a2a8-d797aabb25f2

	measure 'KPI Headcount delta text' =
			VAR _p = COALESCE ( [1_Headcount LY], 0 )
			VAR _d = IF ( [Has PY], COALESCE ( [1_Headcount], 0 ) - COALESCE ( [1_Headcount LY], 0 ) )
			RETURN
			    IF ( ISBLANK ( _d ), "", IF ( _d = 0, "No change", IF ( _d > 0, "▲ +", "▼ −" ) & FORMAT ( ABS ( _d ), "#,0" ) & IF ( _p <> 0, " · " & IF ( _d > 0, "+", IF ( _d < 0, "−", "" ) ) & FORMAT ( ABS ( _d / _p ), "0.0%" ) ) ) )
		displayFolder: Rep 5
		lineageTag: b80de2de-2fcb-4289-9548-6f469baa54b4

	measure 'KPI Headcount delta font' =
			VAR _d = IF ( [Has PY], COALESCE ( [1_Headcount], 0 ) - COALESCE ( [1_Headcount LY], 0 ) )
			RETURN
