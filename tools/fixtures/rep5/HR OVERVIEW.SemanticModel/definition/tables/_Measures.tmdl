	/// Employees active on the day before the first day of the selected period.
	measure 'Headcount Start' =
			VAR _Start = MIN('Date'[Date]) - 1
			RETURN
			    CALCULATE(
			        COUNTROWS('DataTable'),
			        'DataTable'[HireDate] <= _Start,
			        ISBLANK('DataTable'[TerminationDate]) ||
			        'DataTable'[TerminationDate] > _Start
			    )
		formatString: #,0
		displayFolder: Model
		lineageTag: d5fff592-c14a-436c-9580-1cf08479cc4c

	/// Headcount at the start of the period plus headcount at the end, divided by 2.
	measure 'Average Headcount' =
			DIVIDE(
			    COALESCE('_Measures'[Headcount Start], 0) + '_Measures'[1_Headcount],
			    2
			)
		formatString: #,0.0
		displayFolder: Model
		lineageTag: 7f227e77-300d-43a5-9570-ef1017d2da7c

	/// Total salary of active employees divided by headcount, at the end of the period.
	measure 'Average Salary' = DIVIDE('_Measures'[3_TotalSalary], '_Measures'[1_Headcount])
		formatString: \$#,0
		displayFolder: Model
		lineageTag: 4e5812ff-5591-448f-8f6f-5bd77be13229

	/// Hires minus terminations in the period.
	measure 'Net Change' = '_Measures'[2_Hires] - '_Measures'[4_Terminations]
		formatString: +#,0;-#,0;0
		displayFolder: Model
		lineageTag: d10aa1fa-9d44-4834-8a25-048f45326a47

	/// False only when the period has no previous year in 'Date' (2020).
	measure 'Has PY' = NOT ISBLANK ( CALCULATE ( MAX ( 'Date'[Date] ), SAMEPERIODLASTYEAR ( 'Date'[Date] ) ) )
		isHidden
		displayFolder: Rep 5
		lineageTag: 471debf7-55e9-4c81-8827-a97575fa0c83

	/// Rates start in 2021: 2020 begins with no staff (hire rate 200%).
	measure Rated = YEAR ( MIN ( 'Date'[Date] ) ) >= 2021
		isHidden
		displayFolder: Rep 5
		lineageTag: b572ce4c-1437-4b2e-928e-56bbd402c5e5

	measure 'Period label' =
			VAR _d1 = MIN ( 'Date'[Date] )
			VAR _d2 = MAX ( 'Date'[Date] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _d1 ), BLANK (),
			        YEAR ( _d1 ) <> YEAR ( _d2 ), FORMAT ( _d1, "yyyy" ) & "–" & FORMAT ( _d2, "yyyy" ),
			        MONTH ( _d1 ) = 1 && MONTH ( _d2 ) = 12, FORMAT ( _d1, "yyyy" ),
			        MONTH ( _d1 ) = MONTH ( _d2 ), FORMAT ( _d1, "mmm yyyy" ),
			        MONTH ( _d1 ) = ( QUARTER ( _d1 ) - 1 ) * 3 + 1 && MONTH ( _d2 ) = QUARTER ( _d1 ) * 3,
			            "Q" & QUARTER ( _d1 ) & " " & YEAR ( _d1 ),
			        FORMAT ( _d1, "mmm" ) & "–" & FORMAT ( _d2, "mmm yyyy" )
			    )
		displayFolder: Rep 5
		lineageTag: d4135904-15cf-41e0-a88d-1e842412c286

	measure 'Period label LY' = CALCULATE ( [Period label], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		displayFolder: Rep 5
		lineageTag: 607f2f23-4f6c-4e42-9066-e946e4eb36a1

	measure 'Hire rate from 2021' = IF ( [Rated], [5_HireRate] )
		formatString: 0.0%
		displayFolder: Rep 5
		lineageTag: 66ad558f-727c-4947-93f9-6d79712ce30f

	measure 'Hire rate from 2021 LY' = CALCULATE ( [Hire rate from 2021], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.0%
