	measure 'Likert SVG' = ```
			VAR _o = SELECTEDVALUE ( 'Rating'[Order], 0 )
			VAR _A = COALESCE ( [1_Headcount], 0 )
			VAR _L = COALESCE ( [Leavers to date], 0 )
			VAR _body =
			    SWITCH (
			        _o,
			        1, 
			            VAR _a0 = DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "Low" ), _A, 0 )
			            VAR _l0 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "Low" ), _L, 0 )
			            VAR _a1 = DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "Medium" ), _A, 0 )
			            VAR _l1 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "Medium" ), _L, 0 )
			            VAR _a2 = DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "High" ), _A, 0 )
			            VAR _l2 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "High" ), _L, 0 )
			            VAR _a3 = DIVIDE ( CALCULATE ( [1_Headcount], 'DataTable'[Job satisfaction] = "Very High" ), _A, 0 )
			            VAR _l3 = DIVIDE ( CALCULATE ( [Leavers to date], 'DataTable'[Job satisfaction] = "Very High" ), _L, 0 )
			            VAR _g0 = ( _l0 - _a0 ) * 100 VAR _g1 = ( _l1 - _a1 ) * 100 VAR _g2 = ( _l2 - _a2 ) * 100 VAR _g3 = ( _l3 - _a3 ) * 100
			            VAR _k = SWITCH ( TRUE (), ABS ( _g0 ) >= MAX ( MAX ( ABS ( _g0 ), ABS ( _g1 ) ), MAX ( ABS ( _g2 ), ABS ( _g3 ) ) ), 0, ABS ( _g1 ) >= MAX ( MAX ( ABS ( _g0 ), ABS ( _g1 ) ), MAX ( ABS ( _g2 ), ABS ( _g3 ) ) ), 1, ABS ( _g2 ) >= MAX ( MAX ( ABS ( _g0 ), ABS ( _g1 ) ), MAX ( ABS ( _g2 ), ABS ( _g3 ) ) ), 2, ABS ( _g3 ) >= MAX ( MAX ( ABS ( _g0 ), ABS ( _g1 ) ), MAX ( ABS ( _g2 ), ABS ( _g3 ) ) ), 3 )
			            VAR _gk = SWITCH ( _k, 0, _g0, 1, _g1, 2, _g2, 3, _g3 )
			            VAR _note = IF ( _L = 0, "no leavers yet", IF ( ABS ( _gk ) < 0.5, "leavers and active rate it alike",
			                "“" & SWITCH ( _k, 0, "Low", 1, "Medium", 2, "High", 3, "Very High" ) & "”: leavers " & IF ( _gk > 0, "+", "−" ) & FORMAT ( ABS ( _gk ), "0.0" ) & " pts" ) )
			            RETURN
