	measure 'Flow line axis min' =
			VAR _y = MAX ( 'Date'[Year] )
			VAR _t = ADDCOLUMNS ( GENERATESERIES ( 1, 12, 1 ), "@c", CALCULATE ( [1_Headcount], FILTER ( ALL ( 'Date' ), 'Date'[Year] = _y && 'Date'[Month Number] = [Value] ) ) )
			VAR _l = FILTER ( ADDCOLUMNS ( GENERATESERIES ( 1, 12, 1 ), "@c", CALCULATE ( [1_Headcount LY], FILTER ( ALL ( 'Date' ), 'Date'[Year] = _y && 'Date'[Month Number] = [Value] ) ) ), NOT ISBLANK ( [@c] ) )
			VAR _lo = MIN ( MINX ( _t, [@c] ), COALESCE ( MINX ( _l, [@c] ), MINX ( _t, [@c] ) ) )
			VAR _hi = MAX ( MAXX ( _t, [@c] ), COALESCE ( MAXX ( _l, [@c] ), MAXX ( _t, [@c] ) ) )
			VAR _r = MAX ( _hi - _lo, 1 )
			RETURN _lo - 1.7 * _r
		formatString: 0
		isHidden
		displayFolder: Rep 5
		lineageTag: 744e222c-d8e1-4c21-9b5b-29eb7549e085

	measure 'Flow line axis max' =
			VAR _y = MAX ( 'Date'[Year] )
			VAR _t = ADDCOLUMNS ( GENERATESERIES ( 1, 12, 1 ), "@c", CALCULATE ( [1_Headcount], FILTER ( ALL ( 'Date' ), 'Date'[Year] = _y && 'Date'[Month Number] = [Value] ) ) )
			VAR _l = FILTER ( ADDCOLUMNS ( GENERATESERIES ( 1, 12, 1 ), "@c", CALCULATE ( [1_Headcount LY], FILTER ( ALL ( 'Date' ), 'Date'[Year] = _y && 'Date'[Month Number] = [Value] ) ) ), NOT ISBLANK ( [@c] ) )
			VAR _lo = MIN ( MINX ( _t, [@c] ), COALESCE ( MINX ( _l, [@c] ), MINX ( _t, [@c] ) ) )
			VAR _hi = MAX ( MAXX ( _t, [@c] ), COALESCE ( MAXX ( _l, [@c] ), MAXX ( _t, [@c] ) ) )
			VAR _r = MAX ( _hi - _lo, 1 )
			RETURN _hi + 0.22 * _r
		formatString: 0
		isHidden
		displayFolder: Rep 5
		lineageTag: 13e9ae00-6f7a-410a-bb9a-cd9a85c89162

