table _Measures
	lineageTag: ce14314c-7ff9-4c66-8002-07e2b8533c9b

	measure _Blank = 0
		formatString: 0
		isHidden
		lineageTag: 4c28d31f-d60d-49ae-8bc7-202c736683e7

	measure 1_Headcount =
			
			CALCULATE(
			COUNTROWS('DataTable'),
			'DataTable'[HireDate] <= MAX('Date'[Date]),
			ISBLANK('DataTable'[TerminationDate]) ||
			'DataTable'[TerminationDate] > MAX('Date'[Date])
			)
		formatString: 0
		displayFolder: Model
		lineageTag: f8a8c8a3-7372-450c-ab9d-8c4af8537b05

	measure 3_TotalSalary =
			CALCULATE(
			    SUM('DataTable'[Salary]),
			    'DataTable'[HireDate] <= MAX('Date'[Date]),
			    ISBLANK('DataTable'[TerminationDate]) ||
			    'DataTable'[TerminationDate] > MAX('Date'[Date])
			)
		formatString: \$#,0
		displayFolder: Model
		lineageTag: f5d10ac2-4e12-47a5-839a-5487f6ea7d51

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 2_Hires = ```
			CALCULATE(
			        COUNTROWS('DataTable'),
			        'DataTable'[HireDate] >= MIN('Date'[Date]),
			        'DataTable'[HireDate] <= MAX('Date'[Date])
			    )
			
			    
			```
		formatString: 0
		displayFolder: Model
		lineageTag: 62231096-1ba1-4714-835a-6638652dee96

	measure 4_Terminations =
			VAR _t =
			    CALCULATE (
			        COUNTROWS ( 'DataTable' ),
			        NOT ISBLANK ( 'DataTable'[TerminationDate] ),
			        'DataTable'[TerminationDate] >= MIN ( 'Date'[Date] ),
			        'DataTable'[TerminationDate] <= MAX ( 'Date'[Date] )
			    )
			RETURN
			    -- 0 when there were employees in the period but nobody left; blank when the selection had no employees (fix round 1)
			    IF ( ISBLANK ( _t ) && [Average Headcount] > 0, 0, _t )
		formatString: 0
		displayFolder: Model
		lineageTag: 69e1f685-9fd9-4863-85ce-fb3fdc148e98

	measure 5_HireRate =
			DIVIDE(
			    '_Measures'[2_Hires],
			    '_Measures'[Average Headcount],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Model
		lineageTag: 26a2b413-21c0-488b-a86a-eb9a107f9521

	measure 6_TerminationRate =
			DIVIDE(
			    '_Measures'[4_Terminations],
			    '_Measures'[Average Headcount],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Model
		lineageTag: fdbac5a1-7a4c-4de0-a124-a81fb462b042

	measure '1_Headcount LY' = ```
			
			 CALCULATE([1_Headcount],SAMEPERIODLASTYEAR('Date'[Date]))
			
			    
