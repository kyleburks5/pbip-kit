	/// Annual salary. Hidden: not shown on visuals in this rep.
	column Salary
		dataType: double
		isHidden
		lineageTag: b51d0fd4-172f-4ee9-9ede-62d877e2d7b1
		summarizeBy: none
		sourceColumn: Salary

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Years from hire to termination, or to the 2024-12-31 snapshot for active employees.
	column 'Tenure Years' = ( COALESCE ( 'DataTable'[TerminationDate], DATE ( 2024, 12, 31 ) ) - 'DataTable'[HireDate] ) / 365.25
		dataType: double
		isHidden
		formatString: 0.0
		lineageTag: bb4dac13-40b5-4065-9233-e5daa22f013c
		summarizeBy: none

	/// Sort order for Tenure Band (built from the source dates, not from Tenure Band, to avoid a circular sort).
	column 'Tenure Band Sort' = VAR y = ( COALESCE ( 'DataTable'[TerminationDate], DATE ( 2024, 12, 31 ) ) - 'DataTable'[HireDate] ) / 365.25 RETURN SWITCH ( TRUE (), y < 1, 1, y < 2, 2, y < 3, 3, 4 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7976b13e-fdfb-437d-99f1-595deedab4dd
		summarizeBy: none

	/// Tenure at leaving, or at the 2024-12-31 snapshot for active employees: Under 1, 1–2, 2–3, 3–5 years.
	column 'Tenure Band' = VAR y = ( COALESCE ( 'DataTable'[TerminationDate], DATE ( 2024, 12, 31 ) ) - 'DataTable'[HireDate] ) / 365.25 RETURN SWITCH ( TRUE (), y < 1, "Under 1 year", y < 2, "1–2 years", y < 3, "2–3 years", "3–5 years" )
		dataType: string
		lineageTag: c8438d24-195e-42fb-8a66-81994c2977b7
		summarizeBy: none
		sortByColumn: 'Tenure Band Sort'

	partition DataTable = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\pbip-data\HR practice\Adjusted_HR_Dataset.csv"),[Delimiter=",", Columns=13, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"EmployeeID", Int64.Type}, {"EmploymentType", type text}, {"Department", type text}, {"Gender", type text}, {"AgeGroup", type text}, {"Education", type text}, {"JobRole", type text}, {"JobSatisfaction", type text}, {"Performance", type text}, {"WorkLifeBalance", type text}, {"HireDate", type date}, {"TerminationDate", type date}, {"Salary", type number}})
				in
				    #"Changed Type"

	changedProperty = Name

	annotation PBI_ResultType = Table

