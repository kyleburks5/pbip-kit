table Calendar
	dataCategory: Time

	column Date
		dataType: dateTime
		sourceColumn: Date

	column Year
		dataType: int64
		sourceColumn: Year

	column 'Month No'
		dataType: int64
		sourceColumn: Month No

	column Month
		dataType: string
		sourceColumn: Month
		sortByColumn: 'Month No'

	partition Calendar = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2025, 12, 31 ) ), "Year", YEAR ( [Date] ), "Month No", MONTH ( [Date] ), "Month", FORMAT ( [Date], "MMM" ) )
