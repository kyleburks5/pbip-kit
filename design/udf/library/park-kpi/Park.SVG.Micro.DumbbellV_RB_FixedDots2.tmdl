function 'Park.SVG.Micro.DumbbellV_RB_FixedDots2' =
		
		/*
		  KPI 12 — Vertical dumbbell (thick rounded connector + two dots)
		  FULL SVG (Image URL ready). Uses shared Base + Geo + Axis helpers.
		
		  Parameters (exactly 8):
		    _CurrentExpr, _PastExpr, _DateNumber, _DateVal,
		    _AccentUp, _AccentDown,
		    _AxisFont, _AxisFontSize
		*/
		(
		  _CurrentExpr   : NUMERIC EXPR,
		  _PastExpr      : NUMERIC EXPR,
		  _DateNumber    : ANYREF  EXPR,   // numeric order
		  _DateVal       : ANYREF  EXPR,   // display text
		  _AccentUp      : STRING  VAL,
		  _AccentDown    : STRING  VAL,
		  _AxisFont      : STRING  VAL,
		  _AxisFontSize  : NUMERIC VAL
		)
		=>
		/* ── micro-config ─────────────────────────────────────────────────────────── */
		VAR __SvgW     = 400
		VAR __SvgH     = 170
		VAR __PadL     = 55
		VAR __PadR     = 30
		VAR __Ticks    = 5
		
		VAR __LineW    = 15
		VAR __DotR     = 5
		VAR __DotCurr  = "{{colors.text}}"
		VAR __DotPast  = "{{colors.secondLight}}"
		
		VAR __UpCol    = IF( NOT ISBLANK(_AccentUp),   _AccentUp,   "{{colors.good}}" )
		VAR __DownCol  = IF( NOT ISBLANK(_AccentDown), _AccentDown, "{{colors.secondLight}}" )
		VAR __Font     = IF( NOT ISBLANK(_AxisFont),   _AxisFont,   "{{font.family}}" )
		VAR __FS       = IF( NOT ISBLANK(_AxisFontSize), _AxisFontSize, 15 )
		
		/* 1) Base via helper (single grouped table) */
		VAR _Base =
		    Park.SVG.Tab.Base_ByNumText(
		      _CurrentExpr, _PastExpr, _DateNumber, _DateVal
		    )
		VAR __Empty  = COUNTROWS(_Base) = 0
		VAR MinValue = 0
		VAR MaxValue = MAXX(_Base, MAX([PY],[CY]))
		
		/* 2) Geometry via helper (adds Xc, Y_Past, Y_Curr, Y0 per point) */
		VAR _Geo =
		    Park.SVG.Tab.Geo_Vertical_ByNumText(
		      _CurrentExpr, _PastExpr,
		      _DateNumber, _DateVal,
		      __SvgW, __SvgH, __PadL, __PadR
		    )
		
		/* 3) Thick rounded connector + dots (single pass per point) */
		VAR _PerPoint =
		    IF(
		      __Empty, "",
		      CONCATENATEX(
		        ADDCOLUMNS(
		          _Geo,
		          "ColLn", IF([CY] >= [PY], __UpCol, __DownCol)
		        ),
		        VAR x  = [Xc]
		        VAR yc = [Y_Curr]
		        VAR yp = [Y_Past]
		        RETURN
		            // rounded vertical connector
		            "<line x1='" & x & "' x2='" & x &
		            "' y1='" & yc & "' y2='" & yp &
		            "' stroke='" & [ColLn] &
		            "' stroke-width='" & __LineW &
		            "' stroke-linecap='round' vector-effect='non-scaling-stroke' />" &
		            // past dot
		            "<circle cx='" & x & "' cy='" & yp &
		            "' r='" & __DotR & "' fill='" & __DotPast & "' />" &
		            // current dot
		            "<circle cx='" & x & "' cy='" & yc &
		            "' r='" & __DotR & "' fill='" & __DotCurr & "' />",
		        " ",
		        _DateNumber, ASC
		      )
		    )
		
		/* 4) Axes via shared helpers (no custom shifts) */
		VAR _XAxis =
		    IF(
		      __Empty, "",
		      Park.SVG.Frag.XLabels_Vertical_ByNumText(
		        _CurrentExpr, _PastExpr, _DateNumber, _DateVal,
		        __SvgW, __SvgH, __PadL, __PadR,
		        "{{colors.textMuted}}", __Font, __FS
		      )
		    )
		
		VAR _YAxis =
		    IF(
		      __Empty, "",
		      Park.SVG.Frag.YLabels_FromRange(
		        MinValue, MaxValue, __Ticks,
		        __SvgH, __PadL, __PadR,
		        "{{colors.textMuted}}", __Font, __FS
		      )
		    )
		
		/* 5) Assemble FULL SVG */
		RETURN
		IF(
		  __Empty,
		  BLANK(),
		  "data:image/svg+xml;utf8," &
		  "<svg width='" & __SvgW & "' height='" & __SvgH & "' xmlns='http://www.w3.org/2000/svg'>" &
		    _PerPoint &
		    _XAxis &
		    _YAxis &
		  "</svg>"
		)
