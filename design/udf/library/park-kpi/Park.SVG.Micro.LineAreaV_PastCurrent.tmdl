function 'Park.SVG.Micro.LineAreaV_PastCurrent' =
		
		(
		  _CurrentExpr   : NUMERIC EXPR,
		  _PastExpr      : NUMERIC EXPR,
		  _DateNumber    : ANYREF  EXPR,
		  _DateVal       : ANYREF  EXPR,
		  _ColorUp       : STRING  VAL,
		  _ColorDown     : STRING  VAL,
		  _AxisFont      : STRING  VAL,
		  _AxisFontSize  : NUMERIC VAL
		)
		=>
		VAR __SvgW  = 400
		VAR __SvgH  = 170
		VAR __PadL  = 55
		VAR __PadR  = 30
		VAR __Ticks = 5
		VAR __Alpha = "0.5"
		
		VAR __UpClr   = IF(NOT ISBLANK(_ColorUp),   _ColorUp,   "{{colors.text}}")
		VAR __DownClr = IF(NOT ISBLANK(_ColorDown), _ColorDown, "{{colors.secondLight}}")
		VAR __Font    = IF(NOT ISBLANK(_AxisFont),  _AxisFont,  "{{font.family}}")
		VAR __FS      = IF(NOT ISBLANK(_AxisFontSize), _AxisFontSize, 15)
		
		VAR _Base = Park.SVG.Tab.Base_ByNumText(_CurrentExpr, _PastExpr, _DateNumber, _DateVal)
		VAR __Empty = COUNTROWS(_Base) = 0
		VAR MinValue = 0
		VAR MaxValue = MAXX(_Base, MAX([CY],[PY]))
		
		VAR _LastBase = TOPN(1, _Base, _DateNumber, DESC)
		VAR __LineClr = IF( MAXX(_LastBase,[CY]) < MAXX(_LastBase,[PY]), __DownClr, __UpClr )
		
		VAR _Geo =
		    Park.SVG.Tab.Geo_Vertical_ByNumText(
		      _CurrentExpr, _PastExpr, _DateNumber, _DateVal,
		      __SvgW, __SvgH, __PadL, __PadR
		    )
		
		VAR _PastPts = IF(__Empty, "", CONCATENATEX(_Geo, [Xc] & "," & [Y_Past], " ", _DateNumber, ASC))
		VAR _CurPts  = IF(__Empty, "", CONCATENATEX(_Geo, [Xc] & "," & [Y_Curr], " ", _DateNumber, ASC))
		VAR _MinX = IF(__Empty, BLANK(), MINX(_Geo, [Xc]))
		VAR _MaxX = IF(__Empty, BLANK(), MAXX(_Geo, [Xc]))
		VAR _Y0   = IF(__Empty, BLANK(), MAXX(_Geo, [Y0]))
		
		VAR _PastArea =
		    IF(__Empty, "", "<polygon points='" & _PastPts & " " & _MaxX & "," & _Y0 & " " & _MinX & "," & _Y0 &
		                    "' fill='" & __DownClr & "' opacity='" & __Alpha & "' />")
		VAR _CurLine =
		    IF(__Empty, "", "<polyline points='" & _CurPts & "' fill='none' stroke='" & __LineClr & "' stroke-width='2' />")
		
		VAR _XAxis =
		    IF(__Empty, "", Park.SVG.Frag.XLabels_Vertical_ByNumText(
		                      _CurrentExpr, _PastExpr, _DateNumber, _DateVal,
		                      __SvgW, __SvgH, __PadL, __PadR, "{{colors.textMuted}}", __Font, __FS ))
		VAR _YAxis =
		    IF(__Empty, "", Park.SVG.Frag.YLabels_FromRange(
		                      MinValue, MaxValue, __Ticks,
		                      __SvgH, __PadL, __PadR, "{{colors.textMuted}}", __Font, __FS ))
		
		RETURN
		IF(
		  __Empty, BLANK(),
		  "data:image/svg+xml;utf8," &
		  "<svg width='" & __SvgW & "' height='" & __SvgH & "' xmlns='http://www.w3.org/2000/svg'>" &
		    _PastArea & _CurLine & _XAxis & _YAxis &
		  "</svg>"
		)
