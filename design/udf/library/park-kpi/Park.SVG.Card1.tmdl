function 'Park.SVG.Card1' = ```
		( 
		        _CurrentExpr : NUMERIC EXPR,
		        _PastExpr    : NUMERIC EXPR,
		        _LabelExpr   : STRING  EXPR,
		        _IconExpr    : STRING  EXPR,
		        _AccentExpr  : STRING  EXPR,
		        // K-02 style (BLANK() = the kit's design token)
		        _Font           : STRING  VAL,
		        _TextColor      : STRING  VAL,
		        _MutedColor     : STRING  VAL,
		        _SurfaceColor   : STRING  VAL,
		        _BorderColor    : STRING  VAL,
		        _GoodColor      : STRING  VAL,
		        _BadColor       : STRING  VAL,
		        // K-11 change arrow: "triangle" (default: solid ▲ / ▼ as the kit's native KPI cards) or "chevron"
		        _ArrowShape     : STRING  VAL
		    ) =>
		    /// K-02 style: each colour and font from the arguments, or the kit's design token
		    VAR __Font     = IF( ISBLANK( _Font ), "{{font.family}}", _Font )
		    VAR __Text     = IF( ISBLANK( _TextColor ), "{{colors.text}}", _TextColor )
		    VAR __Muted    = IF( ISBLANK( _MutedColor ), "{{colors.textMuted}}", _MutedColor )
		    VAR __Surface  = IF( ISBLANK( _SurfaceColor ), "{{colors.card}}", _SurfaceColor )
		    VAR __Border   = IF( ISBLANK( _BorderColor ), "{{colors.border}}", _BorderColor )
		    VAR __Good     = IF( ISBLANK( _GoodColor ), "{{colors.good}}", _GoodColor )
		    VAR __Bad      = IF( ISBLANK( _BadColor ), "{{colors.bad}}", _BadColor )
		    /// Inputs
		    VAR _cur     = _CurrentExpr
		    VAR _prv     = _PastExpr
		    VAR _label   = _LabelExpr
		    VAR _iconParam = _IconExpr
		    VAR _accent  = _AccentExpr
		    VAR _prefix  = "$"
		    VAR _capPct  = 100
		
		    /// Trend
		    VAR _trendVal = _cur - _prv
		    VAR _trendPct = DIVIDE( _trendVal, _prv, 0 ) * 100
		    VAR _trendTxt = IF( ISBLANK( _prv ), "–", FORMAT( _trendPct, "+0;-0;0" ) & "%" )  // K-10: signed, as the bar reads
		    VAR _isUp     = _trendPct >= 0
		    VAR _trendClr = IF( ISBLANK( _prv ), __Muted, IF( _isUp, __Good, __Bad ) )
		
		    /// Value text
		    VAR _valTxt = _prefix & FORMAT( DIVIDE( _cur, 1000 ), "#,##0.0" ) & "K"
		
		    /// Card layout
		    VAR _w      = 250
		    VAR _h      = 140
		    VAR _pad    = 20
		    VAR _radius = 8
		
		    /// Colors & fonts
		    VAR _bg       = __Surface
		    VAR _border   = __Border
		    VAR _clrLabel = __Muted
		    VAR _clrValue = __Text
		    VAR _clrSub   = __Muted
		    VAR _font     = __Font
		    VAR _fsLabel  = 13
		    VAR _fsValue  = 26
		    VAR _fsSub    = 13
		    VAR _fsTrend  = 14
		    VAR _fsScale  = 9
		
		    /// Progress bar geometry
		    VAR _barW       = _w - ( 2 * _pad )
		    VAR _barH       = 6
		    VAR _barY       = _h - 35
		    VAR _progPctAbs = MIN( ABS( _trendPct ), _capPct )
		    VAR _progW      = _barW * DIVIDE( _progPctAbs, _capPct )
		
		    /// SVG parts
		    VAR _svgPrefix =
		        "data:image/svg+xml;utf8,<svg width='" & _w & "' height='" & _h & "' xmlns='http://www.w3.org/2000/svg'>"
		
		    VAR _cardRect =
		        "<rect x='0' y='0' width='" & _w & "' height='" & _h & "' rx='" & _radius & "' fill='" & _bg & "' stroke='" & _border & "' stroke-width='1'/>"
		
		    /// Icon (left, 20x20)
		    VAR _isB64 = LEFT( _iconParam, 14 ) = "data:image/png"
		    VAR _iconSvg =
		        IF(
		            _isB64,
		            "<image x='" & _pad & "' y='" & _pad & "' width='20' height='20' href='" & _iconParam & "'/>",
		            "<rect x='" & _pad & "' y='" & _pad & "' width='20' height='20' rx='4' fill='" & _accent & "20'/>"
		            & "<path d='M" & ( _pad + 5 ) & " " & ( _pad + 10 )
		            & " L" & ( _pad + 10 ) & " " & ( _pad + 5 )
		            & " L" & ( _pad + 15 ) & " " & ( _pad + 10 )
		            & " L" & ( _pad + 10 ) & " " & ( _pad + 15 )
		            & " Z' fill='" & _accent & "'/>"
		        )
		
		    VAR _labelSvg =
		        "<text x='" & ( _pad + 28 ) & "' y='" & ( _pad + 15 ) & "' font-family='" & _font & "' font-size='" & _fsLabel & "' fill='" & _clrLabel & "'>" & _label & "</text>"
		
		    VAR _valueSvg =
		        "<text x='" & _pad & "' y='65' font-family='" & _font & "' font-size='" & _fsValue & "' font-weight='bold' fill='" & _clrValue & "'>" & _valTxt & "</text>"
		
		    VAR _subSvg =
		        "<text x='" & _pad & "' y='85' font-family='" & _font & "' font-size='" & _fsSub & "' fill='" & _clrSub & "'>From last year</text>"
		
		    VAR _trendSvg =
		        "<text x='" & ( _w - _pad ) & "' y='85' font-family='" & _font & "' font-size='" & _fsTrend & "' font-weight='500' fill='" & _trendClr & "' text-anchor='end'>" & _trendTxt & "</text>"
		
		    VAR __Shape = IF( ISBLANK( _ArrowShape ), "triangle", LOWER( TRIM( _ArrowShape ) ) )  // K-11
		    /// K-11 the change arrow, left of the change text (right-aligned at the card's edge)
		    VAR _arX = _w - _pad - LEN( _trendTxt ) * 8 - 14
		    VAR _arY = 80
		    VAR _arrowSvg =
		        IF(
		            ISBLANK( _prv ),
		            "",
		        IF(
		            __Shape = "chevron",
		            IF(
		                _isUp,
		                "<path d='M" & _arX & " " & ( _arY + 3 ) & " L" & ( _arX + 4 ) & " " & ( _arY - 1 ) & " L" & ( _arX + 8 ) & " " & ( _arY + 3 ) & "' stroke='" & _trendClr & "' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/>",
		                "<path d='M" & _arX & " " & ( _arY - 1 ) & " L" & ( _arX + 4 ) & " " & ( _arY + 3 ) & " L" & ( _arX + 8 ) & " " & ( _arY - 1 ) & "' stroke='" & _trendClr & "' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/>"
		            ),
		            IF(
		                _isUp,
		                "<path d='M" & _arX & " " & ( _arY + 4 ) & " L" & ( _arX + 9 ) & " " & ( _arY + 4 ) & " L" & ( _arX + 4.5 ) & " " & ( _arY - 3 ) & " Z' fill='" & _trendClr & "'/>",
		                "<path d='M" & _arX & " " & ( _arY - 3 ) & " L" & ( _arX + 9 ) & " " & ( _arY - 3 ) & " L" & ( _arX + 4.5 ) & " " & ( _arY + 4 ) & " Z' fill='" & _trendClr & "'/>"
		            )
		        )
		        )

		    VAR _barBg =
		        "<rect x='" & _pad & "' y='" & _barY & "' width='" & _barW & "' height='" & _barH & "' rx='" & ( _barH / 2 ) & "' fill='" & __Border & "'/>"
		
		    VAR _barFill =
		        "<rect x='" & _pad & "' y='" & _barY & "' width='" & _progW & "' height='" & _barH & "' rx='" & ( _barH / 2 ) & "' fill='" & _accent & "'/>"
		
		    VAR _scaleStart =
		        "<text x='" & _pad & "' y='" & ( _barY + 20 ) & "' font-family='" & _font & "' font-size='" & _fsScale & "' fill='" & __Muted & "' text-anchor='start'>-" & FORMAT( _capPct, "0" ) & "%</text>"
		
		    VAR _scaleMid =
		        "<text x='" & ( _w / 2 ) & "' y='" & ( _barY + 20 ) & "' font-family='" & _font & "' font-size='" & _fsScale & "' fill='" & __Muted & "' text-anchor='middle'>0%</text>"
		
		    VAR _scaleEnd =
		        "<text x='" & ( _w - _pad ) & "' y='" & ( _barY + 20 ) & "' font-family='" & _font & "' font-size='" & _fsScale & "' fill='" & __Muted & "' text-anchor='end'>+" & FORMAT( _capPct, "0" ) & "%</text>"
		
		    VAR _svgSuffix = "</svg>"
		
		    VAR _svg =
		        _svgPrefix
		        & _cardRect
		        & _iconSvg
		        & _labelSvg
		        & _valueSvg
		        & _subSvg
		        & _trendSvg
		        & _arrowSvg
		        & _barBg
		        & _barFill
		        & _svgSuffix
		
		    /// K-09 a blank current value: the card with its label and a muted "No data", so the layout keeps its shape
		    VAR _noData =
		        _svgPrefix & _cardRect & _iconSvg & _labelSvg
		        & "<text x='" & _pad & "' y='65' font-family='" & _font & "' font-size='16' fill='" & __Muted & "'>No data</text>"
		        & _svgSuffix
		
		    RETURN IF( ISBLANK( _cur ), _noData, _svg )  // K-05, K-09
		```
