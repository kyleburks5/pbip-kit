function 'Park.SVG.BasicLineChart' = ```
		/*
		  SVG KPI 1 — single line with max/min markers and labels
		  Returns a full ImageUrl SVG (data:image/svg+xml;utf8,...)
		
		  Inputs
		    _CurrentExpr   : NUMERIC EXPR  // e.g. [Sales]
		    _DateNum       : ANYREF  EXPR  // e.g. 'Date'[Month Number] (ordering key)
		    _DateText      : ANYREF  EXPR  // e.g. 'Date'[Month] (display text)
		
		    _SvgW          : NUMERIC VAL   // default 400
		    _SvgH          : NUMERIC VAL   // default 150
		    _Pad           : NUMERIC VAL   // default 30
		    _DesiredTicks  : NUMERIC VAL   // default 5
		    _StrokeColor   : STRING  VAL   // default "{{colors.text}}"
		    _PointRadius   : NUMERIC VAL   // default 5
		
		  Notes
		    • Avoids anti-patterns by grouping ADDCOLUMNS tables once, then reusing them in CONCATENATEX.
		    • Reuses helpers: Park.SVG.Aux.NiceStep, Park.SVG.Fmt.AbbrevKMB.
		*/
		( 
		  _CurrentExpr   : NUMERIC EXPR,
		  _DateNum       : ANYREF  EXPR,
		  _DateText      : ANYREF  EXPR,
		
		  _StrokeColor   : STRING  VAL
		)
		=> 
		VAR __SvgW   = 400
		VAR __SvgH   = 150 
		VAR __Pad    = 40  
		VAR __Ticks  = 5 
		VAR __Stroke = IF ( NOT ISBLANK( _StrokeColor ), _StrokeColor, "{{colors.text}}" )
		VAR __R      = 5
		
		/* 1) Series in current filter context (group once) */
		VAR _TS =
		  ADDCOLUMNS (
		    SUMMARIZE ( 'Date', _DateNum, _DateText ),
		    "Value", COALESCE ( _CurrentExpr, 0 )
		  )
		
		/* 2) Min/Max + step */
		VAR _MinValue = 0
		VAR _MaxValue = MAXX ( _TS, [Value] )
		VAR _MinOrder = MINX ( _TS, _DateNum )
		VAR _Step     = Park.SVG.Aux.NiceStep ( _MinValue, _MaxValue, __Ticks )
		
		/* 3) Geometry (scales) */
		VAR _NPoints  = MAX ( COUNTROWS ( _TS ), 1 )
		VAR _XScale   = DIVIDE ( __SvgW - ( 2 * __Pad ), MAX ( _NPoints - 1, 1 ) )
		VAR _YScale   = DIVIDE ( __SvgH - ( 2 * __Pad ), MAX ( _MaxValue - _MinValue, 1 ) )
		
		/* 4) Per-point geometry (group once, reuse everywhere) */
		VAR _Geo =
		  ADDCOLUMNS (
		    _TS,
		    "X", __Pad + ( _DateNum - _MinOrder ) * _XScale,
		    "Y", __SvgH - __Pad - ( [Value] - _MinValue ) * _YScale,
		    "Lbl1", LEFT ( _DateText, 1 )
		  )
		
		/* 5) Extrema rows (reuse grouped table) */
		VAR _MaxRow = TOPN ( 1, _Geo, [Value], DESC, _DateNum, DESC )
		VAR _MinRow = TOPN ( 1, _Geo, [Value], ASC,  _DateNum, ASC  )
		VAR _Extrema = UNION ( _MaxRow, _MinRow )
		
		/* 6) Precomputed Y-ticks (group once) */
		VAR _YTicks =
		  ADDCOLUMNS (
		    GENERATESERIES ( _MinValue, _MaxValue, _Step ),
		    "YPos", __SvgH - __Pad - ( [Value] - _MinValue ) * _YScale,
		    "Lbl",  Park.SVG.Fmt.AbbrevKMB ( [Value] )
		  )
		
		/* 7) SVG fragments — each CONCATENATEX over prebuilt tables only */
		VAR _PolylinePts =
		  CONCATENATEX ( _Geo, [X] & "," & [Y], " ", _DateNum, ASC )
		
		VAR _Circles =
		  CONCATENATEX (
		    _Extrema,
		    "<circle cx='" & [X] & "' cy='" & [Y] & "' r='" & __R & "' fill='{{colors.text}}' />",
		    " "
		  )
		
		VAR _Labels =
		  CONCATENATEX (
		    _Extrema,
		    "<text x='" & [X] & "' y='" & ( [Y] - 10 ) &
		    "' font-size='15' text-anchor='middle' font-family='Arial' fill='{{colors.text}}'>" &
		      FORMAT ( [Value], "#,0" ) & "</text>",
		    " "
		  )
		
		VAR _XAxis =
		  CONCATENATEX (
		    _Geo,
		    "<text x='" & [X] & "' y='" & ( __SvgH - 5 ) &
		    "' font-size='15' text-anchor='middle' font-family='Arial' fill='{{colors.textMuted}}'>" &
		      [Lbl1] & "</text>",
		    " ",
		    _DateNum, ASC
		  )
		
		VAR _YAxis =
		  CONCATENATEX (
		    _YTicks,
		    "<text x='" & ( __Pad - 5 ) & "' y='" & [YPos] &
		    "' font-size='15' text-anchor='end' font-family='Arial' fill='{{colors.textMuted}}'>" &
		      [Lbl] & "</text>",
		    " "
		  )
		
		/* 8) Assemble SVG */
		VAR _SVG =
		  "data:image/svg+xml;utf8," &
		  "<svg width='" & __SvgW & "' height='" & __SvgH & "' xmlns='http://www.w3.org/2000/svg'>" &
		    "<polyline points='" & _PolylinePts & "' fill='none' stroke='" & __Stroke & "' stroke-width='2' />" &
		    _Circles &
		    _Labels &
		    _XAxis &
		    _YAxis &
		  "</svg>"
		
		RETURN _SVG
		```
